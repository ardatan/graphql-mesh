{
  "name": "@graphql-mesh/incontext-sdk-codegen",
  "version": "0.3.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/incontext-sdk-codegen"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-codegen/core": "^6.2.0",
    "@graphql-codegen/plugin-helpers": "^7.4.2",
    "@graphql-codegen/typescript": "^7.0.0",
    "@graphql-mesh/cross-helpers": "^0.4.18",
    "@graphql-mesh/fusion-runtime": "patch:@graphql-mesh/fusion-runtime@npm%3A1.13.3#~/.yarn/patches/@graphql-mesh-fusion-runtime-npm-1.13.3-efe60c8c1c.patch",
    "@graphql-mesh/transport-common": "^1.1.2",
    "@graphql-mesh/types": "^0.107.3",
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/utils": "^13.2.2",
    "@graphql-tools/wrap": "^11.2.5",
    "graphql-scalars": "^2.0.1",
    "pascal-case": "^3.1.2",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
