{
  "name": "@graphql-mesh/fusion-composition",
  "version": "0.11.4",
  "type": "module",
  "description": "Basic composition utility for Fusion spec",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/fusion/composition"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/schema": "^11.0.9",
    "@graphql-tools/stitching-directives": "^4.1.5",
    "@graphql-tools/utils": "^13.2.2",
    "@theguild/federation-composition": "^0.27.0",
    "change-case": "^4.1.2",
    "graphql-scalars": "^2.0.1",
    "minimatch": "^11.0.1",
    "pluralize": "^8.0.0",
    "snake-case": "^3.0.0",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@graphql-hive/gateway-runtime": "^2.13.4",
    "@graphql-mesh/fusion-runtime": "patch:@graphql-mesh/fusion-runtime@npm%3A1.13.3#~/.yarn/patches/@graphql-mesh-fusion-runtime-npm-1.13.3-efe60c8c1c.patch",
    "@graphql-tools/delegate": "^12.3.3",
    "@graphql-tools/executor": "4.1.8",
    "@repeaterjs/repeater": "3.1.0",
    "@types/minimatch": "6.0.0",
    "@types/pluralize": "^0.0.33",
    "@whatwg-node/promise-helpers": "^2.0.1",
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
