type Query @join__type(graph:A) @join__type(graph:B) {myFoo:Foo! @join__field(graph:A) foo(id:ID!):Foo! @join__directive(graphs:[B] name:"lookup" args:{}) @join__field(graph:B) foos(ids:[ID!]!):[Foo!]! @join__directive(graphs:[B] name:"merge" args:{keyField:"id" keyArg:"ids"}) @join__field(graph:B) foosByFilter(where:FooFilter!):[Foo!]! @join__field(graph:B)}
type Foo @join__type(graph:A) @join__type(graph:B key:"id") {id:ID! bar:String! @join__field(graph:B)}
input FooFilter @join__type(graph:B) {id:ID id_in:[ID!]}
directive @join__directive(graphs:[join__Graph!] name:String! args:join__DirectiveArguments) repeatable on SCHEMA | OBJECT | INTERFACE | FIELD_DEFINITION | ARGUMENT_DEFINITION
scalar join__DirectiveArguments

