{
  "name": "@graphql-tools/federation",
  "version": "5.0.0",
  "type": "module",
  "description": "Apollo Federation utilities for GraphQL tools",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/federation"
  },
  "author": "Arda TANRIKULU <ardatanrikulu@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@apollo/server-gateway-interface": "^2.2.0",
    "@graphql-tools/delegate": "workspace:*",
    "@graphql-tools/executor": "^4.1.8",
    "@graphql-tools/executor-http": "workspace:*",
    "@graphql-tools/merge": "^10.0.9",
    "@graphql-tools/schema": "^11.0.9",
    "@graphql-tools/stitch": "workspace:*",
    "@graphql-tools/utils": "^13.2.3",
    "@graphql-tools/wrap": "workspace:*",
    "@graphql-yoga/typed-event-target": "^4.0.0",
    "@whatwg-node/disposablestack": "^0.1.0",
    "@whatwg-node/events": "^0.1.2",
    "@whatwg-node/fetch": "^0.12.1",
    "@whatwg-node/promise-helpers": "^2.0.2",
    "change-case": "^4.1.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@apollo/gateway": "^2.14.4",
    "@apollo/server": "^5.5.2",
    "@apollo/subgraph": "^2.17.0",
    "@graphql-hive/federation-gateway-audit": "0.0.3",
    "@graphql-yoga/plugin-defer-stream": "^4.1.1",
    "@types/lodash": "4.17.27",
    "graphql": "17.1.0",
    "graphql-yoga": "^6.1.1"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
