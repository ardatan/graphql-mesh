{
  "name": "@graphql-mesh/transport-connect",
  "version": "0.12.4",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/transports/connect"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@apollo/subgraph": "^2.16.0",
    "@graphql-hive/logger": "^2.0.0",
    "@graphql-hive/pubsub": "^3.0.0",
    "@graphql-mesh/cross-helpers": "^0.4.18",
    "@graphql-mesh/string-interpolation": "^0.5.18",
    "@graphql-mesh/transport-common": "^2.0.0",
    "@graphql-mesh/types": "^0.107.3",
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/utils": "^13.2.3",
    "@whatwg-node/fetch": "^0.12.1",
    "@whatwg-node/promise-helpers": "^2.0.2",
    "dataloader": "^2.2.2",
    "dset": "^3.1.3",
    "fast-xml-parser": "^5.10.1",
    "graphql-fields": "^2.0.3",
    "graphql-scalars": "^2.0.1",
    "http-string-parser": "^0.0.6",
    "pascal-case": "^3.1.2",
    "qs": "^6.16.1",
    "tslib": "^2.4.0",
    "url-join": "4.0.1"
  },
  "devDependencies": {
    "@types/http-string-parser": "0.0.33",
    "graphql": "17.1.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
