{
  "name": "@graphql-mesh/transport-common",
  "version": "3.0.0",
  "type": "module",
  "description": "Common transport utilities for GraphQL Mesh",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/transports/common"
  },
  "author": "Arda TANRIKULU <ardatanrikulu@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.9.0 || ^17.0.0"
  },
  "dependencies": {
    "@envelop/core": "^6.0.1",
    "@graphql-hive/logger": "^2.0.0",
    "@graphql-hive/pubsub": "^3.0.0",
    "@graphql-hive/signal": "^3.0.0",
    "@graphql-mesh/types": "^1.0.0",
    "@graphql-tools/executor": "^4.1.8",
    "@graphql-tools/executor-common": "workspace:*",
    "@graphql-tools/utils": "^13.2.3",
    "@whatwg-node/promise-helpers": "^2.0.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@graphql-mesh/cross-helpers": "^0.4.19",
    "@graphql-mesh/utils": "^1.0.0",
    "graphql": "17.1.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
