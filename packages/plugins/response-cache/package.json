{
  "name": "@graphql-mesh/plugin-response-cache",
  "version": "0.107.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/plugins/response-cache"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "*"
  },
  "dependencies": {
    "@envelop/core": "^5.5.1",
    "@envelop/response-cache": "^9.1.1",
    "@graphql-mesh/cross-helpers": "^0.4.16",
    "@graphql-mesh/string-interpolation": "^0.5.18",
    "@graphql-mesh/types": "^0.107.1",
    "@graphql-mesh/utils": "^0.107.1",
    "@graphql-tools/utils": "^11.2.2",
    "@graphql-yoga/plugin-response-cache": "^3.23.2",
    "@whatwg-node/promise-helpers": "^1.0.0",
    "cache-control-parser": "^2.2.0",
    "graphql-yoga": "^5.21.2",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@graphql-hive/gateway-runtime": "^2.10.7",
    "@graphql-mesh/fusion-composition": "^0.11.2",
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
