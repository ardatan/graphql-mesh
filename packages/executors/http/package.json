{
  "name": "@graphql-tools/executor-http",
  "version": "4.0.0",
  "type": "module",
  "description": "HTTP GraphQL executor",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/executors/http"
  },
  "author": "Arda TANRIKULU <ardatanrikulu@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-hive/signal": "^3.0.0",
    "@graphql-tools/executor-common": "workspace:*",
    "@graphql-tools/utils": "^13.2.3",
    "@repeaterjs/repeater": "^3.1.0",
    "@whatwg-node/disposablestack": "^0.1.0",
    "@whatwg-node/fetch": "^0.12.1",
    "@whatwg-node/promise-helpers": "^2.0.2",
    "extract-files": "14.0.0",
    "meros": "^1.3.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.2",
    "@types/extract-files": "13.0.2",
    "@whatwg-node/disposablestack": "^0.1.0",
    "graphql": "17.1.0",
    "graphql-yoga": "^6.1.1"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
