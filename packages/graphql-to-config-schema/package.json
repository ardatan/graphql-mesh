{
  "name": "@graphql-mesh/config-schema",
  "version": "0.2.0",
  "type": "module",
  "description": "Use GraphQL SDL to define YAML/JSON config schemas for GraphQL Mesh",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/graphql-to-config-schema"
  },
  "author": "Arda TANRIKULU <ardatanrikulu@gmail.com>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "graphql-to-config-schema": "dist/cjs/bin.js"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-tools/graphql-file-loader": "^9.1.2",
    "@graphql-tools/json-file-loader": "^9.0.9",
    "@graphql-tools/load": "^9.1.3",
    "@graphql-tools/url-loader": "^10.0.9",
    "@graphql-tools/utils": "^13.2.3",
    "json-schema-to-typescript": "^8.2.0",
    "tslib": "^2.4.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/yargs": "^17.0.33",
    "graphql": "17.1.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "buildOptions": {
    "bin": {
      "graphql-to-config-schema": {
        "input": "src/bin.ts"
      }
    }
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
