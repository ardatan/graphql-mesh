{
  "name": "@graphql-mesh/http",
  "version": "0.109.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/legacy/http"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-hive/logger": "^1.1.1",
    "@graphql-mesh/runtime": "^0.109.3",
    "@graphql-mesh/types": "^0.107.3",
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/utils": "^13.2.1",
    "@whatwg-node/promise-helpers": "^2.0.1",
    "@whatwg-node/server": "^0.13.2",
    "graphql-yoga": "^6.0.1",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@types/lodash.get": "4.4.9",
    "@types/mkdirp": "2.0.0",
    "@types/rimraf": "4.0.5",
    "@types/ws": "8.18.2",
    "@types/yargs": "17.0.35",
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
