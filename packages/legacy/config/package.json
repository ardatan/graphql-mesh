{
  "name": "@graphql-mesh/config",
  "version": "0.111.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/legacy/config"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "*"
  },
  "dependencies": {
    "@envelop/core": "^6.0.0",
    "@graphql-hive/logger": "^1.1.1",
    "@graphql-hive/pubsub": "^2.2.1",
    "@graphql-mesh/cache-localforage": "^0.108.3",
    "@graphql-mesh/merger-bare": "^0.108.3",
    "@graphql-mesh/merger-stitching": "^0.108.3",
    "@graphql-mesh/runtime": "^0.109.3",
    "@graphql-mesh/store": "^0.107.3",
    "@graphql-mesh/types": "^0.107.3",
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/code-file-loader": "^9.1.1",
    "@graphql-tools/graphql-file-loader": "^9.1.1",
    "@graphql-tools/load": "^9.1.1",
    "@graphql-tools/utils": "^13.2.1",
    "@graphql-yoga/plugin-persisted-operations": "^4.0.1",
    "@whatwg-node/disposablestack": "^0.1.0",
    "@whatwg-node/fetch": "^0.12.1",
    "camel-case": "^4.1.2",
    "graphql-yoga": "^6.0.1",
    "param-case": "^3.0.4",
    "pascal-case": "^3.1.2",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
