{
  "name": "@graphql-mesh/grpc",
  "version": "0.113.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/legacy/handlers/grpc"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-hive/logger": "^1.1.1",
    "@graphql-hive/pubsub": "^2.2.1",
    "@graphql-mesh/store": "^0.108.0",
    "@graphql-mesh/transport-grpc": "^0.8.0",
    "@graphql-mesh/types": "^0.108.0",
    "@graphql-mesh/utils": "^0.108.0",
    "@omnigraph/grpc": "^0.4.0",
    "@whatwg-node/disposablestack": "^0.1.0",
    "@whatwg-node/promise-helpers": "^2.0.1",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
