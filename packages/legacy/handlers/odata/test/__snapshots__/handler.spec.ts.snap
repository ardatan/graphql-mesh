 Options present in the URI. The set of valid values for the $inlinecount query option are shown in the table below. If a value other than one shown in Table 4 is specified the URI is considered malformed.""" inlinecount:InlineCount count:Boolean}
enum InlineCount {"""The OData MUST include a count of the number of entities in the collection identified by the URI (after applying any $filter System Query Options present on the URI)""" allpages """The OData service MUST NOT include a count in the response. This is equivalence to a URI that does not include a $inlinecount query string parameter.""" none}
input PersonInput {UserName:String! FirstName:String! LastName:String MiddleName:String Age:BigInt Emails:[String]}
type Message @key(fields:"Id" resolvable:false) {Id:String! Contents:String! """OData @odata.id (inaccessible; absolute URL for nested @connect paths)""" _odataId:String @inaccessible}
type Query {People(queryOptions:QueryOptions):[Person] @connect(source:"SampleService" http:{GET:"/People" queryParams:"{\\n  \\"$filter\\": $args.queryOptions.filter\\n  \\"$orderby\\": $args.queryOptions.orderby\\n  \\"$top\\": $args.queryOptions.top\\n  \\"$skip\\": $args.queryOptions.skip\\n  \\"$search\\": $args.queryOptions.search\\n  \\"$count\\": $args.queryOptions.count\\n  \\"$inlinecount\\": $args.queryOptions.inlinecount\\n}"} selection:"$.value { UserName FirstName LastName MiddleName Age Emails _odataId: $->get(\\"@odata.id\\") }") PeopleByUserName(UserName:String!):Person @connect(source:"SampleService" http:{GET:"/People/{$args.UserName}/"} selection:"UserName FirstName LastName MiddleName Age Emails _odataId: $->get(\\"@odata.id\\")" entity:true) PeopleCount(queryOptions:QueryOptions):Int @connect(source:"SampleService" http:{GET:"/People/$count" queryParams:"{\\n  \\"$filter\\": $args.queryOptions.filter\\n  \\"$orderby\\": $args.queryOptions.orderby\\n  \\"$top\\": $args.queryOptions.top\\n  \\"$skip\\": $args.queryOptions.skip\\n  \\"$search\\": $args.queryOptions.search\\n  \\"$count\\": $args.queryOptions.count\\n  \\"$inlinecount\\": $args.queryOptions.inlinecount\\n}"} selection:"$") """Federation entity resolver for Connectors REST transport (Hive \`_entities\` path)""" _entities(representations:[_Any!]!):[_Entity]!}
type Mutation {People(queryOptions:QueryOptions):[Person] @connect(source:"SampleService" http:{GET:"/People" queryParams:"{\\n  \\"$filter\\": $args.queryOptions.filter\\n  \\"$orderby\\": $args.queryOptions.orderby\\n  \\"$top\\": $args.queryOptions.top\\n  \\"$skip\\": $args.queryOptions.skip\\n  \\"$search\\": $args.queryOptions.search\\n  \\"$count\\": $args.queryOptions.count\\n  \\"$inlinecount\\": $args.queryOptions.inlinecount\\n}"} selection:"$.value { UserName FirstName LastName MiddleName Age Emails _odataId: $->get(\\"@odata.id\\") }") PeopleByUserName(UserName:String!):Person @connect(source:"SampleService" http:{GET:"/People/{$args.UserName}/"} selection:"UserName FirstName LastName MiddleName Age Emails _odataId: $->get(\\"@odata.id\\")") createPeople(input:PersonInput):Person @connect(source:"SampleService" http:{POST:"/People" body:"$args.input"} selection:"UserName FirstName LastName MiddleName Age Emails _odataId: $->get(\\"@odata.id\\")") deletePeopleByUserName(UserName:String!):JSON @connect(source:"SampleService" http:{DELETE:"/People/{$args.UserName}/"} selection:"$") updatePeopleByUserName(UserName:String!
input:PersonUpdateInput):Person @connect(source:"SampleService" http:{PATCH:"/People/{$args.UserName}/" body:"$args.input"} selection:"UserName FirstName LastName MiddleName Age Emails _odataId: $->get(\\"@odata.id\\")")} """The \`JSON\`
scalar
type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf)."""
scalar JSON @specifiedBy(url:"http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")
input PersonUpdateInput {UserName:String FirstName:String LastName:String MiddleName:String Age:BigInt Emails:[String]}
input ConnectHTTP {GET:URLPathTemplate HEAD:URLPathTemplate POST:URLPathTemplate PUT:URLPathTemplate PATCH:URLPathTemplate DELETE:URLPathTemplate headers:[HTTPHeaderMapping!] body:JSONSelection queryParams:JSONSelection} """A URL path with optional parameters, mapping to GraphQL fields or arguments"""
scalar URLPathTemplate
input HTTPHeaderMapping {name:String! value:String from:String} """A custom syntax for mapping JSON data to GraphQL schema"""
scalar JSONSelection
input ConnectorErrors {message:JSONSelection extensions:JSONSelection}
input SourceHTTP {baseURL:String! headers:[HTTPHeaderMapping!] queryParams:JSONSelection}
scalar _Any
union _Entity = Person

`;
