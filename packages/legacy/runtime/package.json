{
  "name": "@graphql-mesh/runtime",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/legacy/runtime"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@envelop/core": "^6.0.1",
    "@envelop/extended-validation": "^8.0.2",
    "@graphql-hive/logger": "^2.0.0",
    "@graphql-hive/pubsub": "^3.0.0",
    "@graphql-mesh/cross-helpers": "^0.4.19",
    "@graphql-mesh/string-interpolation": "^0.6.0",
    "@graphql-mesh/types": "^1.0.0",
    "@graphql-mesh/utils": "^1.0.0",
    "@graphql-tools/batch-delegate": "^12.0.0",
    "@graphql-tools/delegate": "^14.0.0",
    "@graphql-tools/executor": "^4.1.8",
    "@graphql-tools/utils": "^13.2.3",
    "@graphql-tools/wrap": "^13.0.0",
    "@whatwg-node/disposablestack": "^0.1.0",
    "@whatwg-node/fetch": "^0.12.1",
    "@whatwg-node/promise-helpers": "^2.0.2",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@graphql-tools/schema": "11.0.9",
    "graphql": "17.1.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
