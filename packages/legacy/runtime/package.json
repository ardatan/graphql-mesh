{
  "name": "@graphql-mesh/runtime",
  "version": "0.109.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/legacy/runtime"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@envelop/core": "^6.0.0",
    "@envelop/extended-validation": "^8.0.0",
    "@graphql-hive/logger": "^1.1.1",
    "@graphql-hive/pubsub": "^2.2.1",
    "@graphql-mesh/cross-helpers": "^0.4.18",
    "@graphql-mesh/string-interpolation": "^0.5.18",
    "@graphql-mesh/types": "^0.107.3",
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/batch-delegate": "^10.1.4",
    "@graphql-tools/delegate": "^12.3.2",
    "@graphql-tools/executor": "^4.1.7",
    "@graphql-tools/utils": "^13.2.1",
    "@graphql-tools/wrap": "^11.2.4",
    "@whatwg-node/disposablestack": "^0.1.0",
    "@whatwg-node/fetch": "^0.12.1",
    "@whatwg-node/promise-helpers": "^2.0.1",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@graphql-tools/schema": "11.0.8",
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
