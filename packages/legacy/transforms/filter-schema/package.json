{
  "name": "@graphql-mesh/transform-filter-schema",
  "version": "0.107.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/legacy/transforms/filter-schema"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "*"
  },
  "dependencies": {
    "@graphql-mesh/types": "^0.107.3",
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/delegate": "^12.3.2",
    "@graphql-tools/utils": "^13.2.1",
    "@graphql-tools/wrap": "^11.2.4",
    "minimatch": "^11.0.1",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@types/minimatch": "6.0.0",
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
