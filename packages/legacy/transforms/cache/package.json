{
  "name": "@graphql-mesh/transform-cache",
  "version": "0.108.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/legacy/transforms/cache"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "*"
  },
  "dependencies": {
    "@graphql-hive/pubsub": "^2.2.1",
    "@graphql-mesh/string-interpolation": "^0.5.18",
    "@graphql-mesh/types": "^0.107.3",
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/resolvers-composition": "^8.0.8",
    "@graphql-tools/schema": "^11.0.8",
    "@graphql-tools/utils": "^13.2.1",
    "@whatwg-node/promise-helpers": "^2.0.1",
    "dayjs": "^1.11.21",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@graphql-mesh/cache-localforage": "0.108.3",
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
