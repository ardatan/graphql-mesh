{
  "name": "@graphql-tools/stitch",
  "version": "11.0.0",
  "type": "module",
  "description": "Schema stitching utilities for combining GraphQL schemas",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/stitch"
  },
  "author": "Arda TANRIKULU <ardatanrikulu@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-tools/batch-delegate": "workspace:*",
    "@graphql-tools/delegate": "workspace:*",
    "@graphql-tools/executor": "^4.1.8",
    "@graphql-tools/merge": "^10.0.9",
    "@graphql-tools/schema": "^11.0.9",
    "@graphql-tools/utils": "^13.2.3",
    "@graphql-tools/wrap": "workspace:*",
    "@whatwg-node/promise-helpers": "^2.0.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.8",
    "@graphql-tools/mock": "^10.1.4",
    "array-shuffle": "4.1.0",
    "dataloader": "^2.2.3",
    "graphql": "17.1.0",
    "graphql-yoga": "^6.1.1",
    "rxjs": "^7.8.2"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
