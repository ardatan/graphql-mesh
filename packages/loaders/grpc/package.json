{
  "name": "@omnigraph/grpc",
  "version": "0.3.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/loaders/grpc"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@ardatan/grpc-reflection-js": "^0.0.2",
    "@graphql-hive/logger": "^1.1.1",
    "@graphql-mesh/string-interpolation": "^0.5.18",
    "@graphql-mesh/transport-common": "^1.1.1",
    "@graphql-tools/load-files": "^8.0.8",
    "@graphql-tools/utils": "^13.2.1",
    "@grpc/grpc-js": "^1.14.5",
    "@whatwg-node/disposablestack": "^0.1.0",
    "graphql-compose": "^9.1.0",
    "graphql-scalars": "^2.0.1",
    "lodash.has": "^4.5.2",
    "micromatch": "^4.0.8",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "graphql": "16.14.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
