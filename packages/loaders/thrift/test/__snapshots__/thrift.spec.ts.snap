exports[`thrift Twitter: Twitter-schema 1`] = `
"schema @transport(subgraph: "Twitter", kind: "thrift", location: "http://localhost:4000/twitter", headers: [["x-api-key", "123"]]) {
  query: Query
}

directive @thrift__rpc(subgraph: String, service: String, function: String!, args: String!, selection: String!, messageType: ThriftMessageType = CALL, entity: Boolean) on FIELD_DEFINITION

enum ThriftMessageType {
  CALL
  ONEWAY
}

type TwitterUnavailable {
  message: String
}

type Query {
  ping: Void @thrift__rpc(subgraph: "Twitter", function: "ping", args: "", selection: "$(void)", messageType: CALL, service: "twitter-service")
  postTweet(tweet: TweetInput): Boolean @thrift__rpc(subgraph: "Twitter", function: "postTweet", args: "1(struct): $args.tweet {\\n  1(i32): userId\\n  2(string): userName\\n  3(string): text\\n  4(struct): loc {\\n    1(double): latitude\\n    2(double): longitude\\n  }\\n  5(i32): tweetType\\n  16(string): language\\n}", selection: "$(bool)", messageType: CALL, service: "twitter-service")
  searchTweets(query: String): TweetSearchResult @thrift__rpc(subgraph: "Twitter", function: "searchTweets", args: "1(string): $args.query", selection: "tweets: 1(list) {\\n  userId: 1(i32)\\n  userName: 2(string)\\n  text: 3(string)\\n  loc: 4 {\\n    latitude: 1(double)\\n    longitude: 2(double)\\n  }\\n  tweetType: 5(i32)\\n  language: 16(string)\\n}", messageType: CALL, service: "twitter-service")
  zip: Void @thrift__rpc(subgraph: "Twitter", function: "zip", args: "", selection: "$(void)", messageType: ONEWAY, service: "twitter-service")
}

"""Represents NULL values"""
scalar Void

input TweetInput {
  userId: Int!
  userName: String!
  text: String!
  loc: LocationInput
  tweetType: TweetType
  language: String
}

input LocationInput {
  latitude: Float!
  longitude: Float!
}

enum TweetType {
  TWEET
  RETWEET
  DM
  REPLY
}

type TweetSearchResult {
  tweets: [Tweet]
}

type Tweet {
  userId: Int!
  userName: String!
  text: String!
  loc: Location
  tweetType: TweetType
  language: String
}

type Location {
  latitude: Float!
  longitude: Float!
}"
`;
