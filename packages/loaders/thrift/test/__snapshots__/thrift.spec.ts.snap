exports[`thrift Calc json protocol emits @connect with isSuccess/errors: Calc-json-connect-schema 1`] = `
"schema @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect", "@source"]) @source(name: "Calc", http: {baseURL: "http://localhost:4000/thrift-json", headers: [{name: "Content-Type", value: "application/vnd.apache.thrift.json"}, {name: "Accept", value: "application/vnd.apache.thrift.json"}]}) {
  query: Query
}

directive @connect(source: String, http: ConnectHTTP, selection: JSONSelection!, entity: Boolean, errors: ConnectorErrors, isSuccess: JSONSelection) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHTTP!, errors: ConnectorErrors, isSuccess: JSONSelection) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

type Query {
  add(request: AddRequestInput): Int @connect(source: "Calc", http: {POST: "/", body: """
  $([
    1,
    "add",
    1,
    1,
    {
      "1": {
        "rec": {
          "1": { "i32": $args.request.left },
          "2": { "i32": $args.request.right }
        }
      }
    }
  ])
  """}, selection: """$->get(4)->get("0")->get("i32")""", isSuccess: """$->get(2)->eq(2)->and($->get(4)->get("0")->ne(null))""", errors: {message: """
  $([$->get(4)->get("1")->get("str"), $->get(4)->get("1")->get("rec")->get("1")->get("str")])->joinNotNull("")
  """})
  subtract(left: Int, right: Int): Int @connect(source: "Calc", http: {POST: "/", body: """
  $([
    1,
    "subtract",
    1,
    1,
    {
      "1": { "i32": $args.left },
      "2": { "i32": $args.right }
    }
  ])
  """}, selection: """$->get(4)->get("0")->get("i32")""", isSuccess: """$->get(2)->eq(2)->and($->get(4)->get("0")->ne(null))""", errors: {message: """
  $([$->get(4)->get("1")->get("str"), $->get(4)->get("1")->get("rec")->get("1")->get("str")])->joinNotNull("")
  """})
}

input AddRequestInput {
  left: Int!
  right: Int!
}

input ConnectHTTP {
  GET: URLPathTemplate
  HEAD: URLPathTemplate
  POST: URLPathTemplate
  PUT: URLPathTemplate
  PATCH: URLPathTemplate
  DELETE: URLPathTemplate
  headers: [HTTPHeaderMapping!]
  body: JSONSelection
  queryParams: JSONSelection
}

"""
A URL path with optional parameters, mapping to GraphQL fields or arguments
"""
scalar URLPathTemplate

input HTTPHeaderMapping {
  name: String!
  value: String
  from: String
}

"""A custom syntax for mapping JSON data to GraphQL schema"""
scalar JSONSelection

input ConnectorErrors {
  message: JSONSelection
  extensions: JSONSelection
}

input SourceHTTP {
  baseURL: String!
  headers: [HTTPHeaderMapping!]
  queryParams: JSONSelection
}"
`;

exports[`thrift Calc: Calc-schema 1`] = `
"schema @transport(subgraph: "Calc", kind: "thrift", location: "http://localhost:4000/thrift-with-imports", headers: [["x-api-key", "123"]]) {
  query: Query
}

directive @thrift__rpc(subgraph: String, service: String, function: String!, args: String!, selection: String!, throws: String, messageType: ThriftMessageType = CALL, entity: Boolean) on FIELD_DEFINITION

enum ThriftMessageType {
  CALL
  ONEWAY
}

type Query {
  add(request: AddRequestInput): Int @thrift__rpc(subgraph: "Calc", function: "add", args: """
  1(struct): $args.request {
    1(i32): left
    2(i32): right
  }
  """, selection: "$(i32)", messageType: CALL)
  subtract(left: Int, right: Int): Int @thrift__rpc(subgraph: "Calc", function: "subtract", args: """
  1(i32): $args.left
  2(i32): $args.right
  """, selection: "$(i32)", messageType: CALL)
}

input AddRequestInput {
  left: Int!
  right: Int!
}"
`;

exports[`thrift Twitter: Twitter-schema 1`] = `
"schema @transport(subgraph: "Twitter", kind: "thrift", location: "http://localhost:4000/twitter", headers: [["x-api-key", "123"]]) {
  query: Query
}

directive @thrift__rpc(subgraph: String, service: String, function: String!, args: String!, selection: String!, throws: String, messageType: ThriftMessageType = CALL, entity: Boolean) on FIELD_DEFINITION

enum ThriftMessageType {
  CALL
  ONEWAY
}

type TwitterUnavailable {
  message: String
}

type Query {
  ping: Void @thrift__rpc(subgraph: "Twitter", function: "ping", args: "", selection: "$(void)", messageType: CALL)
  postTweet(tweet: TweetInput): Boolean @thrift__rpc(subgraph: "Twitter", function: "postTweet", args: """
  1(struct): $args.tweet {
    1(i32): userId
    2(string): userName
    3(string): text
    4(struct): loc {
      1(double): latitude
      2(double): longitude
    }
    5(i32): tweetType
    16(string): language
  }
  """, selection: "$(bool)", messageType: CALL)
  searchTweets(query: String): TweetSearchResult @thrift__rpc(subgraph: "Twitter", function: "searchTweets", args: "1(string): $args.query", selection: """
  tweets: 1(list) {
    userId: 1(i32)
    userName: 2(string)
    text: 3(string)
    loc: 4 {
      latitude: 1(double)
      longitude: 2(double)
    }
    tweetType: 5(i32)
    language: 16(string)
  }
  """, messageType: CALL)
  zip: Void @thrift__rpc(subgraph: "Twitter", function: "zip", args: "", selection: "$(void)", messageType: ONEWAY)
}

"""Represents NULL values"""
scalar Void

input TweetInput {
  userId: Int!
  userName: String!
  text: String!
  loc: LocationInput
  tweetType: TweetType
  language: String
}

input LocationInput {
  latitude: Float!
  longitude: Float!
}

enum TweetType {
  TWEET
  RETWEET
  DM
  REPLY
}

type TweetSearchResult {
  tweets: [Tweet]
}

type Tweet {
  userId: Int!
  userName: String!
  text: String!
  loc: Location
  tweetType: TweetType
  language: String
}

type Location {
  latitude: Float!
  longitude: Float!
}"
`;
