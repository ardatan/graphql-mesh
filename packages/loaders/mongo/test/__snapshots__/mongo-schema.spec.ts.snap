type User @key(fields: "id") @mongo(subgraph: "users", collection: "user_users", kind: FIND_ONE, where: """

  _id: $this.id
""", selection: """
  id: _id
  name: name
  age: age
  languages: languages
  gender: gender
  address: address
  someMixed: someMixed
  salaryDecimal: salaryDecimal
  contacts: contacts
""") {
  id: ID!
  name: String
  age: Float
  languages: [UserLanguages]
  gender: EnumUserGender
  address: UserAddress
  """Some dynamic data"""
  someMixed: JSON
  salaryDecimal: Decimal128
  contacts: UserContacts
}

type UserLanguages {
  language: String
  skill: EnumUserLanguagesSkill
}

enum EnumUserLanguagesSkill {
  basic
  fluent
  native
}

enum EnumUserGender {
  male
  female
  not_specified
}

type UserAddress {
  street: String
  geo: [Float]
  _id: ID
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

"""
BSON Decimal128 (Mongoose-compatible cast). Serialized as a decimal string; accepts string, number, or \`{ "$numberDecimal": "…" }\`.
"""
scalar Decimal128

type UserContacts {
  email: String
  phones: [String]
}

input UserOrderByInput {
  id: SortDirection
  name: SortDirection
  age: SortDirection
  gender: SortDirection
  salaryDecimal: SortDirection
}

enum SortDirection {
  ASC
  DESC
}

input UserWhereInput {
  AND: [UserWhereInput!]
  OR: [UserWhereInput!]
  NOT: UserWhereInput
  id: IDFilter
  name: StringFilter
  age: FloatFilter
  languages: [UserLanguagesWhereInput]
  gender: StringFilter
  address: UserAddressWhereInput
  """Some dynamic data"""
  someMixed: JSON
  salaryDecimal: Decimal128Filter
  contacts: UserContactsWhereInput
}

input IDFilter {
  eq: ID
  ne: ID
  in: [ID!]
  nin: [ID!]
  gt: ID
  gte: ID
  lt: ID
  lte: ID
  exists: Boolean
}

input StringFilter {
  eq: String
  ne: String
  in: [String!]
  nin: [String!]
  gt: String
  gte: String
  lt: String
  lte: String
  regex: String
