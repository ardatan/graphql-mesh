type UserPayload {
  record: User
  recordId: ID
  records: [User!]
  recordIds: [ID!]
  createdCount: Int
  modifiedCount: Int
  matchedCount: Int
  deletedCount: Int
  error: MongoError
}

type MongoError implements ErrorInterface {
  message: String
  code: String
}

interface ErrorInterface {
  message: String
}

input UserDocumentInput {
  name: String
  age: Float
  languages: [UserLanguagesInput]
  gender: EnumUserGender
  address: UserAddressInput
  """Some dynamic data"""
  someMixed: JSON
  salaryDecimal: Decimal128
