type User @key(fields: "id") @mongo(subgraph: "users", collection: "user_users", kind: FIND_ONE, filter: """

  _id: $this.id
""", selection: """
  id: _id
  name: name
  age: age
  gender: gender
  someMixed: someMixed
""") {
  id: ID!
  name: String
  age: Float
  gender: String
  someMixed: JSON
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

input UserSort {
  id: SortDirection
  name: SortDirection
  age: SortDirection
  gender: SortDirection
  someMixed: SortDirection
}

enum SortDirection {
  ASC
  DESC
}

input UserFilter {
  AND: [UserFilter!]
  OR: [UserFilter!]
  NOT: UserFilter
  id: IDFilter
  name: StringFilter
  age: FloatFilter
  gender: StringFilter
  someMixed: StringFilter
}

input IDFilter {
  eq: ID
  ne: ID
  in: [ID!]
  nin: [ID!]
  exists: Boolean
}

input StringFilter {
  eq: String
  ne: String
  in: [String!]
  nin: [String!]
  regex: String
  exists: Boolean
}

input FloatFilter {
  eq: Float
  ne: Float
  in: [Float!]
  nin: [Float!]
  gt: Float
  gte: Float
  lt: Float
  lte: Float
  exists: Boolean
}

type UserConnection {
  edges: [UserEdge!]!
  nodes: [User!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type UserEdge {
  cursor: String!
  node: User!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type UserPagination {
  count: Int
  items: [User]
  pageInfo: PaginationInfo
}

type PaginationInfo {
  currentPage: Int!
  perPage: Int!
  pageCount: Int
  itemCount: Int
  hasNextPage: Boolean
  hasPreviousPage: Boolean
}

