type UserPayload {
  record: User
  recordId: ID
  records: [User!]
  recordIds: [ID!]
  createdCount: Int
  modifiedCount: Int
  matchedCount: Int
  deletedCount: Int
  error: MongoError
}

type MongoError implements ErrorInterface {
  message: String
  code: String
}

interface ErrorInterface {
  message: String
}

input CreateUserInput {
  name: String
  age: Float
  languages: [UserLanguagesInput]
  gender: EnumUserGender
  address: UserAddressInput
  """Some dynamic data"""
  someMixed: JSON
  salaryDecimal: Decimal128
  contacts: UserContactsInput
}

input UserLanguagesInput {
  language: String
  skill: EnumUserLanguagesSkill
}

input UserAddressInput {
  street: String
  geo: [Float]
  _id: ID
}

input UserContactsInput {
  email: String
  phones: [String]
}

input UpdateUserInput {
  name: String
  age: Float
  languages: [UserLanguagesInput]
  gender: EnumUserGender
  address: UserAddressInput
  """Some dynamic data"""
  someMixed: JSON
  salaryDecimal: Decimal128
  contacts: UserContactsInput
}

scalar TransportOptions

enum MongoKind {
  FIND_ONE
  FIND_MANY
  COUNT
  CONNECTION
  PAGINATION
  AGGREGATE
  INSERT_ONE
  INSERT_MANY
  UPDATE_ONE
  UPDATE_MANY
