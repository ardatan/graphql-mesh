exports[`@omnigraph/mongo schema emit emits @mongo directives and slim @transport(kind: mongo): user-find-slice 1`] = `
"schema @transport(subgraph: "users", kind: "mongo", location: "mongodb://localhost:27017/test") @link(url: "https://specs.apollo.dev/federation/v2.6", import: ["@key"]) {
  query: Query
}

directive @transport(subgraph: String!, kind: String!, location: String, headers: [[String]], options: TransportOptions) repeatable on SCHEMA

directive @mongo(subgraph: String, collection: String!, kind: MongoKind!, where: String, sort: String, limit: String, skip: String, first: String, after: String, set: String, selection: String, pipeline: String) on FIELD_DEFINITION | OBJECT

type Query {
  User_findById(_id: MongoID!): User @mongo(subgraph: "users", collection: "user_users", kind: FIND_ONE, where: """
  
    _id: $args._id
  """, selection: """
    id: _id
    name: name
    age: age
    gender: gender
    someMixed: someMixed
  """)
  User_findMany(where: UserWhere, limit: Int = 100, skip: Int, sort: UserSort): [User!]! @mongo(subgraph: "users", collection: "user_users", kind: FIND_MANY, where: "$args.where", sort: "$args.sort", limit: "$args.limit", skip: "$args.skip", selection: """
    id: _id
    name: name
    age: age
    gender: gender
    someMixed: someMixed
  """)
  User_findOne(where: UserWhere, skip: Int, sort: UserSort): User @mongo(subgraph: "users", collection: "user_users", kind: FIND_ONE, where: "$args.where", sort: "$args.sort", skip: "$args.skip", selection: """
    id: _id
    name: name
    age: age
    gender: gender
    someMixed: someMixed
  """)
  User_count(where: UserWhere): Int! @mongo(subgraph: "users", collection: "user_users", kind: COUNT, where: "$args.where", selection: """
  
    $
  """)
}

type User @key(fields: "id") @mongo(subgraph: "users", collection: "user_users", kind: FIND_ONE, where: """

  _id: $this.id
""", selection: """
  id: _id
  name: name
  age: age
  gender: gender
  someMixed: someMixed
""") {
  id: MongoID!
  name: String
  age: Float
  gender: String
  someMixed: JSON
}

"""MongoDB ObjectId represented as a 24-char hex string"""
scalar MongoID

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

input UserWhere {
  AND: [UserWhere!]
  OR: [UserWhere!]
  NOT: UserWhere
  id: MongoIDWhere
  name: StringWhere
  age: FloatWhere
  gender: StringWhere
  someMixed: StringWhere
}

input MongoIDWhere {
  eq: MongoID
  ne: MongoID
  in: [MongoID!]
  nin: [MongoID!]
  exists: Boolean
}

input StringWhere {
  eq: String
  ne: String
  in: [String!]
  nin: [String!]
  regex: String
  exists: Boolean
}

input FloatWhere {
  eq: Float
  ne: Float
  in: [Float!]
  nin: [Float!]
  gt: Float
  gte: Float
  lt: Float
  lte: Float
  exists: Boolean
}

input UserSort {
  id: SortDirection
  name: SortDirection
  age: SortDirection
  gender: SortDirection
  someMixed: SortDirection
}

enum SortDirection {
  ASC
  DESC
}

scalar TransportOptions

enum MongoKind {
  FIND_ONE
  FIND_MANY
  COUNT
  CONNECTION
  PAGINATION
  AGGREGATE
  INSERT_ONE
  INSERT_MANY
  UPDATE_ONE
  UPDATE_MANY
  DELETE_ONE
  DELETE_MANY
}"
