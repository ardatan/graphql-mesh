exports[`@omnigraph/mongo schema emit emits @mongo directives with where/orderBy and SQL-style roots: user-full-slice 1`] = `
"schema @transport(subgraph: "users", kind: "mongo", location: "mongodb://localhost:27017/test") @link(url: "https://specs.apollo.dev/federation/v2.6", import: ["@key"]) {
  query: Query
  mutation: Mutation
}

directive @transport(subgraph: String!, kind: String!, location: String, headers: [[String]], options: TransportOptions) repeatable on SCHEMA

directive @mongo(subgraph: String, collection: String!, kind: MongoKind!, where: String, orderBy: String, limit: String, skip: String, first: String, after: String, page: String, perPage: String, set: String, selection: String, pipeline: String) on FIELD_DEFINITION | OBJECT

type Query {
  user(id: ID!): User @mongo(subgraph: "users", collection: "user_users", kind: FIND_ONE, selection: """
    id: _id
    name: name
    age: age
    gender: gender
    someMixed: someMixed
  """, where: """
  
    _id: $args.id
  """)
  usersByIds(ids: [ID!]!, limit: Int = 100, orderBy: UserOrderByInput): [User!]! @mongo(subgraph: "users", collection: "user_users", kind: FIND_MANY, selection: """
    id: _id
    name: name
    age: age
    gender: gender
    someMixed: someMixed
  """, where: """
  
    _id: $args.ids
  """, limit: "$args.limit", orderBy: "$args.orderBy")
  users(where: UserWhereInput, limit: Int = 100, skip: Int, orderBy: UserOrderByInput): [User!]! @mongo(subgraph: "users", collection: "user_users", kind: FIND_MANY, selection: """
    id: _id
    name: name
    age: age
    gender: gender
    someMixed: someMixed
  """, where: "$args.where", orderBy: "$args.orderBy", limit: "$args.limit", skip: "$args.skip")
  findUser(where: UserWhereInput, skip: Int, orderBy: UserOrderByInput): User @mongo(subgraph: "users", collection: "user_users", kind: FIND_ONE, selection: """
    id: _id
    name: name
    age: age
    gender: gender
    someMixed: someMixed
  """, where: "$args.where", orderBy: "$args.orderBy", skip: "$args.skip")
  usersCount(where: UserWhereInput): Int! @mongo(subgraph: "users", collection: "user_users", kind: COUNT, selection: """
  
    $
  """, where: "$args.where")
  allUsers(where: UserWhereInput, first: Int, after: String, orderBy: UserOrderByInput): UserConnection @mongo(subgraph: "users", collection: "user_users", kind: CONNECTION, selection: """
    nodes {
        id: _id
        name: name
        age: age
        gender: gender
        someMixed: someMixed
    }
    edges {
      cursor: $cursor
      node {
          id: _id
          name: name
          age: age
          gender: gender
          someMixed: someMixed
      }
    }
    pageInfo {
      hasNextPage: $hasNextPage
      hasPreviousPage: $hasPreviousPage
      startCursor: $startCursor
      endCursor: $endCursor
    }
    totalCount: $totalCount
  """, where: "$args.where", orderBy: "$args.orderBy", first: "$args.first", after: "$args.after")
  usersPagination(where: UserWhereInput, page: Int, perPage: Int = 20, orderBy: UserOrderByInput): UserPagination @mongo(subgraph: "users", collection: "user_users", kind: PAGINATION, selection: """
    count: $count
    items {
        id: _id
        name: name
        age: age
        gender: gender
        someMixed: someMixed
    }
    pageInfo {
      currentPage: $currentPage
      perPage: $perPage
      pageCount: $pageCount
      itemCount: $itemCount
      hasNextPage: $hasNextPage
      hasPreviousPage: $hasPreviousPage
    }
  """, where: "$args.where", orderBy: "$args.orderBy", page: "$args.page", perPage: "$args.perPage")
}

type User @key(fields: "id") @mongo(subgraph: "users", collection: "user_users", kind: FIND_ONE, where: """

  _id: $this.id
""", selection: """
  id: _id
  name: name
  age: age
  gender: gender
  someMixed: someMixed
""") {
  id: ID!
  name: String
  age: Float
  gender: String
  someMixed: JSON
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

input UserOrderByInput {
  id: SortDirection
  name: SortDirection
  age: SortDirection
  gender: SortDirection
  someMixed: SortDirection
}

enum SortDirection {
  ASC
  DESC
}

input UserWhereInput {
  AND: [UserWhereInput!]
  OR: [UserWhereInput!]
  NOT: UserWhereInput
  id: IDFilter
  name: StringFilter
  age: FloatFilter
  gender: StringFilter
  someMixed: StringFilter
}

input IDFilter {
  eq: ID
  ne: ID
  in: [ID!]
  nin: [ID!]
  exists: Boolean
}

input StringFilter {
  eq: String
  ne: String
  in: [String!]
  nin: [String!]
  regex: String
  exists: Boolean
}

input FloatFilter {
  eq: Float
  ne: Float
  in: [Float!]
  nin: [Float!]
  gt: Float
  gte: Float
  lt: Float
  lte: Float
  exists: Boolean
}

type UserConnection {
  edges: [UserEdge!]!
  nodes: [User!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type UserEdge {
  cursor: String!
  node: User!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type UserPagination {
  count: Int
  items: [User]
  pageInfo: PaginationInfo
}

type PaginationInfo {
  currentPage: Int!
  perPage: Int!
  pageCount: Int
  itemCount: Int
  hasNextPage: Boolean
  hasPreviousPage: Boolean
}

type Mutation {
  createUser(input: CreateUserInput!): UserPayload @mongo(subgraph: "users", collection: "user_users", kind: INSERT_ONE, selection: """
    record {
        id: _id
        name: name
        age: age
        gender: gender
        someMixed: someMixed
    }
    recordId: $_id
  """, set: """
    name: $args.input.name
    age: $args.input.age
    gender: $args.input.gender
    someMixed: $args.input.someMixed
  """)
  createUsers(inputs: [CreateUserInput!]!): UserPayload @mongo(subgraph: "users", collection: "user_users", kind: INSERT_MANY, selection: """
    records {
        id: _id
        name: name
        age: age
        gender: gender
        someMixed: someMixed
    }
    recordIds: $recordIds
    createdCount: $createdCount
  """, set: """
  
    inputs: $args.inputs
  """)
  updateUser(id: ID!, input: UpdateUserInput!): UserPayload @mongo(subgraph: "users", collection: "user_users", kind: UPDATE_ONE, selection: """
    record {
        id: _id
        name: name
        age: age
        gender: gender
        someMixed: someMixed
    }
    recordId: $_id
  """, where: """
  
    _id: $args.id
  """, set: """
    name: $args.input.name
    age: $args.input.age
    gender: $args.input.gender
    someMixed: $args.input.someMixed
  """)
  updateUserWhere(where: UserWhereInput, input: UpdateUserInput!): UserPayload @mongo(subgraph: "users", collection: "user_users", kind: UPDATE_ONE, selection: """
    record {
        id: _id
        name: name
        age: age
        gender: gender
        someMixed: someMixed
    }
    recordId: $_id
  """, where: "$args.where", set: """
    name: $args.input.name
    age: $args.input.age
    gender: $args.input.gender
    someMixed: $args.input.someMixed
  """)
  updateUsers(where: UserWhereInput, input: UpdateUserInput!): UserPayload @mongo(subgraph: "users", collection: "user_users", kind: UPDATE_MANY, selection: """
    modifiedCount: $modifiedCount
    matchedCount: $matchedCount
  """, where: "$args.where", set: """
    name: $args.input.name
    age: $args.input.age
    gender: $args.input.gender
    someMixed: $args.input.someMixed
  """)
  deleteUser(id: ID!): UserPayload @mongo(subgraph: "users", collection: "user_users", kind: DELETE_ONE, selection: """
    record {
        id: _id
        name: name
        age: age
        gender: gender
        someMixed: someMixed
    }
    recordId: $_id
  """, where: """
  
    _id: $args.id
  """)
  deleteUserWhere(where: UserWhereInput): UserPayload @mongo(subgraph: "users", collection: "user_users", kind: DELETE_ONE, selection: """
    record {
        id: _id
        name: name
        age: age
        gender: gender
        someMixed: someMixed
    }
    recordId: $_id
  """, where: "$args.where")
  deleteUsers(where: UserWhereInput!): UserPayload @mongo(subgraph: "users", collection: "user_users", kind: DELETE_MANY, selection: """
  
    deletedCount: $deletedCount
  """, where: "$args.where")
}

type UserPayload {
  record: User
  recordId: ID
  records: [User!]
  recordIds: [ID!]
  createdCount: Int
  modifiedCount: Int
  matchedCount: Int
  deletedCount: Int
}

input CreateUserInput {
  name: String
  age: Float
  gender: String
  someMixed: JSON
}

input UpdateUserInput {
  name: String
  age: Float
  gender: String
  someMixed: JSON
}

scalar TransportOptions

enum MongoKind {
  FIND_ONE
  FIND_MANY
  COUNT
  CONNECTION
  PAGINATION
  AGGREGATE
  INSERT_ONE
  INSERT_MANY
  UPDATE_ONE
  UPDATE_MANY
  DELETE_ONE
  DELETE_MANY
}"
`;
