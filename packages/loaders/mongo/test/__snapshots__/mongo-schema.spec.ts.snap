}

scalar TransportOptions

enum MongoKind {
  FIND_ONE
  FIND_MANY
  COUNT
  CONNECTION
  PAGINATION
  AGGREGATE
  INSERT_ONE
  INSERT_MANY
  UPDATE_ONE
  UPDATE_MANY
