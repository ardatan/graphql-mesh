}

input UserLanguagesInput {
  language: String
  skill: EnumUserLanguagesSkill
}

input UserAddressInput {
  street: String
  geo: [Float]
  _id: ID
}

input UserContactsInput {
  email: String
  phones: [String]
}

scalar TransportOptions

enum MongoKind {
  FIND_ONE
  FIND_MANY
  COUNT
  CONNECTION
  PAGINATION
  AGGREGATE
  INSERT_ONE
  INSERT_MANY
  UPDATE_ONE
  UPDATE_MANY
  DELETE_ONE
