{
  "name": "@omnigraph/openapi",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/loaders/openapi"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-hive/logger": "^1.1.1",
    "@graphql-mesh/cross-helpers": "^0.4.18",
    "@graphql-mesh/fusion-composition": "^1.0.0",
    "@graphql-mesh/string-interpolation": "^1.0.0",
    "@graphql-mesh/types": "^1.0.0",
    "@graphql-mesh/utils": "^1.0.0",
    "@graphql-tools/utils": "^13.2.1",
    "@omnigraph/json-schema": "^1.0.0",
    "change-case": "^4.1.2",
    "json-machete": "^1.0.0",
    "openapi-types": "^12.1.0",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@whatwg-node/fetch": "^0.12.1",
    "fets": "0.8.8",
    "graphql": "16.14.0",
    "graphql-yoga": "^6.0.1",
    "json-bigint-patch": "0.0.9"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
