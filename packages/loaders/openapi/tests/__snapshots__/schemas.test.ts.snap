}

"""This schema provides metadata about a course."""
type CourseResource {
  id: String!
  type: String!
  attributes: CourseAttributes!
  relationships: CourseRelationshipList
}

"""This schema presents the information about a course."""
type CourseAttributes {
  """Description of the accredited body for this course."""
  about_accredited_body: String
