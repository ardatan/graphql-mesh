    id: String!
    """The X coordinate of the top-left corner of the crop region."""
    x: Int
    """The Y coordinate of the top-left corner of the crop region."""
    y: Int
    """The length of each side of the crop region."""
    size: Int!
  ): Avatar @httpOperation(subgraph: "Jira", path: "/rest/api/3/issuetype/{args.id}/avatar2", operationSpecificHeaders: [["Content-Type", "*/*"], ["accept", "application/json"]], httpMethod: POST, queryParamArgMap: "{\\"x\\":\\"x\\",\\"y\\":\\"y\\",\\"size\\":\\"size\\"}")
