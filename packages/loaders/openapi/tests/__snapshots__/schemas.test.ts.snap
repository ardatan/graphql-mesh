input indexes_settings_update_request_Input {
  synonyms: synonyms_Input
  """List of words ignored when present in search queries."""
  stopWords: [String]
  """
  List of ranking rules sorted by order of importance. The order is customizable.
  
  [A list of ordered built-in ranking rules](https://docs.meilisearch.com/learn/core_concepts/relevancy.html).
  """
  rankingRules: [String]
  """
  Search returns documents with distinct (different) values of the given field.
  """
  distinctAttribute: String
  """
  Fields in which to search for matching query words sorted by order of importance.
  """
  searchableAttributes: [String]
  """Fields displayed in the returned documents."""
  displayedAttributes: [String]
  """
  Attributes to use for faceting and filtering. See [Filtering and Faceted Search](https://docs.meilisearch.com/reference/features/filtering_and_faceted_search.html).
  """
  filterableAttributes: [String]
  """List of attributes to sort on at search."""
  sortableAttributes: [String]
  typoTolerance: typoTolerance_Input
  pagination: pagination_Input
  faceting: faceting_Input
}

"""
List of associated words treated similarly. A word associated to an array of word as synonyms.
"""
input synonyms_Input {
  wolverine: [String]
  logan: [String]
  wow: [String]
}

"""Customize typo tolerance feature."""
input typoTolerance_Input {
  """Enable the typo tolerance feature."""
  enabled: Boolean! = true
  """Disable the typo tolerance feature on the specified attributes."""
  disableOnAttributes: [String]! = []
  """
  Disable the typo tolerance feature for a set of query terms given for a search query.
  """
  disableOnWords: [String]! = []
  minWordSizeForTypos: mutationInput_indexes_settings_update_input_typoTolerance_minWordSizeForTypos_Input
}

input mutationInput_indexes_settings_update_input_typoTolerance_minWordSizeForTypos_Input {
  """Customize the minimum size for a word to tolerate 1 typo."""
  oneTypo: Int! = 5
  """Customize the minimum size for a word to tolerate 2 typos."""
  twoTypos: Int! = 9
}

"""Customize pagination settings"""
input pagination_Input {
  """
  Define the maximum number of documents reachable for a search request. It means that with the default value of \`1000\`, it is not possible to see the \`1001\`st result for a **search query**.
  """
  maxTotalHits: Int! = 1000
}

"""Customize faceting settings"""
input faceting_Input {
  """
  Define maximum number of value returned for a facet for a **search query**. It means that with the default value of \`100\`, it is not possible to have \`101\` different colors if the \`color\`\` field is defined as a facet at search time.
  """
  maxValuesPerFacet: Int! = 100
}

