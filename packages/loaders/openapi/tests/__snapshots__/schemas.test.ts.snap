  """If true, indicates that this secret has been deleted"""
  deleted: Boolean
  """
  The Unix timestamp for the expiry time of the secret, after which the secret deletes.
  """
  expires_at: Timestamp
  """Unique identifier for the object."""
  id: query_GetAppsSecrets_oneOf_0_data_items_id!
  """
  Has the value \`true\` if the object exists in live mode or the value \`false\` if the object exists in test mode.
  """
  livemode: Boolean!
  """A name for the secret that's unique within the scope."""
  name: query_GetAppsSecrets_oneOf_0_data_items_name!
  object: apps_secret_const!
  """The plaintext secret value to be stored."""
  payload: query_GetAppsSecrets_oneOf_0_data_items_payload
  scope: SecretServiceResourceScope!
}

