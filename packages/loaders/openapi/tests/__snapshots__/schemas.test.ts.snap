  bursary_amount: Int
  """Description of requirements to be eligible for a bursary."""
  bursary_requirements: [String]
  """
  Date-time timestamp of when this course or any of its related data changed.
  """
  changed_at: DateTime
  """
  Code that uniquely identifies this course within its training provider's list of courses.
  """
  code: query_public_api_v1_courses_data_items_attributes_code!
  """Text describing how long the course runs."""
  course_length: String
  """Timestamp of when this course was created."""
  created_at: DateTime
  """Further details about the fees for this course, if applicable."""
  fee_details: String
  """Fee in GBP for international students (optional)."""
  fee_international: Int
  """Fee in GBP for UK students."""
  fee_domestic: Int
  """Details about financial support offered, if any."""
  financial_support: String
  """
  Is this course currently visible on the Find Postgraduate Teacher Training service.
  """
  findable: Boolean
  funding_type: query_public_api_v1_courses_data_items_attributes_funding_type
  """GSCEs, or equivalent, required for this level of course."""
  gcse_subjects_required: [String]
  """Are any bursaries available for this course?"""
  has_bursary: Boolean
  """Are early career payments available for this course?"""
  has_early_career_payments: Boolean
  """Are scholarships available for this course?"""
  has_scholarship: Boolean
  """Do any of the locations for this course have vacancies?"""
  has_vacancies: Boolean
  """
  Additional information about the schools applicants will be teaching in.
  """
  how_school_placements_work: String
  """
  Additional information about how the interview process will work for applicants.
  """
  interview_process: String
