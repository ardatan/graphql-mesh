  ): JSON @httpOperation(subgraph: "Jira", path: "/rest/api/3/app/field/{args.fieldIdOrKey}/context/configuration", operationSpecificHeaders: [["Content-Type", "application/json"], ["accept", "application/json"]], httpMethod: PUT)
  """
