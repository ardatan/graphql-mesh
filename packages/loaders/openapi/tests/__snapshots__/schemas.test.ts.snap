  """
  fee_details: [Fee]!
  """Unique identifier for the object."""
  id: query_GetAccount_oneOf_0_external_accounts_data_items_anyOf_0_customer_anyOf_1_invoice_settings_default_payment_method_anyOf_1_card_generated_from_setup_attempt_anyOf_1_setup_error_payment_intent_invoice_anyOf_1_charge_anyOf_1_application_fee_anyOf_1_balance_transaction_anyOf_1_id!
