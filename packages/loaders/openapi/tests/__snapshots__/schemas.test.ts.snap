    expand: String
  ): PermissionScheme @httpOperation(subgraph: "Jira", path: "/rest/api/3/permissionscheme/{args.schemeId}", operationSpecificHeaders: [["accept", "application/json"]], httpMethod: GET, queryParamArgMap: "{\\"expand\\":\\"expand\\"}")
