// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Multiple Responses Swagger should create correct response types with 204 empty response: schema 1`] = `
"schema @source(name: "test", http: {baseURL: "https://api.example.com/v1"}) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect", "@source"]) {
  query: Query
  mutation: Mutation
}

directive @connect(source: String, http: ConnectHTTP, selection: String!, entity: Boolean, errors: ConnectorErrors, isSuccess: String) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHTTP!, errors: ConnectorErrors, isSuccess: String) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

type Query {
  """Optional extended description in Markdown."""
  foo_by_id: foo_by_id_response @connect(source: "test", http: {GET: "/{id}", headers: [{name: "Accept", value: "application/json"}]}, selection: "__typename: $status->match([200, \\"Foo\\"], [500, \\"Error\\"], [@, \\"Foo\\"]) id message stack", isSuccess: "$status->match([200, true], [500, true], [@, false])")
}

union foo_by_id_response = Foo | Error

type Foo {
  id: String
}

type Error {
  message: String
  stack: String
}

type Mutation {
  """Optional extended description in Markdown."""
  post: post_response @connect(source: "test", http: {POST: "/", headers: [{name: "Accept", value: "application/json"}]}, selection: "__typename: $status->match([204, \\"Void_container\\"], [500, \\"Error\\"], [@, \\"Void_container\\"]) message stack", isSuccess: "$status->match([204, true], [500, true], [@, false])")
}

union post_response = Void_container | Error

type Void_container {
  Void: Void @connect(selection: "$")
}

"""Represents empty values"""
scalar Void

input ConnectHTTP {
  GET: String
  HEAD: String
  POST: String
  PUT: String
  PATCH: String
  DELETE: String
  headers: [HTTPHeaderMapping!]
  body: String
  queryParams: String
}

input HTTPHeaderMapping {
  name: String!
  value: String
  from: String
}

input ConnectorErrors {
  message: String
  extensions: String
}

input SourceHTTP {
  baseURL: String!
  headers: [HTTPHeaderMapping!]
  queryParams: String
  errors: ConnectorErrors
  isSuccess: String
}"
`;
