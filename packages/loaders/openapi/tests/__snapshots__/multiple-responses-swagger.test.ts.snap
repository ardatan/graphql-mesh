// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Multiple Responses Swagger should create correct response types with 204 empty response: schema 1`] = `
"schema @source(name: "test", http: {baseURL: "https://api.example.com/v1"}) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect", "@source"]) @link(url: "https://the-guild.dev/graphql/mesh/spec/v1.0", import: ["@meshRestOptions"]) {
  query: Query
  mutation: Mutation
}

directive @statusCodeTypeName(subgraph: String, typeName: String, statusCode: String) repeatable on UNION

directive @resolveRoot(subgraph: String) on FIELD_DEFINITION

directive @connect(source: String, http: ConnectHTTP, selection: String!, entity: Boolean, errors: ConnectorErrors, isSuccess: String) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHTTP!, errors: ConnectorErrors, isSuccess: String) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

directive @meshRestOptions(queryStringOptions: ObjMap, queryStringOptionsByParam: ObjMap, requestBaseBody: ObjMap, timeout: Int, isBinary: Boolean) on FIELD_DEFINITION

type Query {
  """Optional extended description in Markdown."""
  foo_by_id: foo_by_id_response @connect(source: "test", http: {GET: "/{id}", headers: [{name: "Accept", value: "application/json"}]}, selection: "__typename: $status->match([200, \\"Foo\\"], [500, \\"Error\\"], [@, \\"Foo\\"])\\nid\\nmessage\\nstack", isSuccess: "$status->match([200, true], [500, true], [@, false])")
}

union foo_by_id_response @statusCodeTypeName(subgraph: "test", statusCode: "200", typeName: "Foo") @statusCodeTypeName(subgraph: "test", statusCode: "500", typeName: "Error") = Foo | Error

type Foo {
  id: String
}

type Error {
  message: String
  stack: String
}

type Mutation {
  """Optional extended description in Markdown."""
  post: post_response @connect(source: "test", http: {POST: "/", headers: [{name: "Accept", value: "application/json"}]}, selection: "__typename: $status->match([204, \\"Void_container\\"], [500, \\"Error\\"], [@, \\"Void_container\\"])\\nVoid\\nmessage\\nstack", isSuccess: "$status->match([204, true], [500, true], [@, false])")
}

union post_response @statusCodeTypeName(subgraph: "test", statusCode: "204", typeName: "Void_container") @statusCodeTypeName(subgraph: "test", statusCode: "500", typeName: "Error") = Void_container | Error

type Void_container {
  Void: Void @resolveRoot(subgraph: "test")
}

"""Represents empty values"""
scalar Void

input ConnectHTTP {
  GET: String
  HEAD: String
  POST: String
  PUT: String
  PATCH: String
  DELETE: String
  headers: [HTTPHeaderMapping!]
  body: String
  queryParams: String
}

input HTTPHeaderMapping {
  name: String!
  value: String
  from: String
}

input ConnectorErrors {
  message: String
  extensions: String
}

input SourceHTTP {
  baseURL: String!
  headers: [HTTPHeaderMapping!]
  queryParams: String
  errors: ConnectorErrors
  isSuccess: String
}

scalar ObjMap"
`;
