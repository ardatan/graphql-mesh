exports[`Escaped Values should generate the correct schema: escaped_values-schema 1`] = `
"schema @source(name: "escaped_values", http: {baseURL: "http://localhost:3000/api"}) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect", "@source"]) @link(url: "https://the-guild.dev/graphql/mesh/spec/v1.0", import: ["@meshRestOptions"]) {
  query: Query
}

directive @enum(subgraph: String, value: String) on ENUM_VALUE

directive @connect(source: String, http: ConnectHTTP, selection: String!, entity: Boolean, errors: ConnectorErrors, isSuccess: String) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHTTP!, errors: ConnectorErrors, isSuccess: String) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

directive @meshRestOptions(queryStringOptions: ObjMap, queryStringOptionsByParam: ObjMap, requestBaseBody: ObjMap, timeout: Int, isBinary: Boolean) on FIELD_DEFINITION

type Query {
  test: test_200_response @connect(source: "escaped_values", http: {GET: "/test", headers: [{name: "accept", value: "application/json"}]}, selection: "test")
}

type test_200_response {
  test: query_test_test
}

enum query_test_test {
  NEGATIVE_1 @enum(subgraph: "escaped_values", value: "-1")
  _0 @enum(subgraph: "escaped_values", value: "0")
  _10 @enum(subgraph: "escaped_values", value: "10")
  _15 @enum(subgraph: "escaped_values", value: "15")
  _30 @enum(subgraph: "escaped_values", value: "30")
  _45 @enum(subgraph: "escaped_values", value: "45")
  _60 @enum(subgraph: "escaped_values", value: "60")
}

input ConnectHTTP {
  GET: String
  HEAD: String
  POST: String
  PUT: String
  PATCH: String
  DELETE: String
  headers: [HTTPHeaderMapping!]
  body: String
  queryParams: String
}

input HTTPHeaderMapping {
  name: String!
  value: String
  from: String
}

