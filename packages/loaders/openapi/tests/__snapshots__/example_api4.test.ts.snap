// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`OpenAPI loader: Handle anyOf and oneOf should generate the schema correctly 1`] = `
"schema @source(name: "test", http: {baseURL: "http://localhost:8080/api"}) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect", "@source"]) {
  query: Query
}

directive @connect(source: String, http: ConnectHTTP, selection: String!, entity: Boolean, errors: ConnectorErrors, isSuccess: String) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHTTP!, errors: ConnectorErrors, isSuccess: String) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

type Query {
  """Basic oneOf test"""
  oneOf: oneOf_200_response @connect(source: "test", http: {GET: "/oneOf", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  """oneOf test with non-object type member schema"""
  oneOf2: oneOf2_200_response @connect(source: "test", http: {GET: "/oneOf2", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  """oneOf test with no object type member schemas"""
  oneOf3: oneOf3_200_response @connect(source: "test", http: {GET: "/oneOf3", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  """oneOf test with extraneous member schemas"""
  oneOf4: Int @connect(source: "test", http: {GET: "/oneOf4", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  """Basic oneOf test with allOf"""
  oneOf5: oneOf5_200_response @connect(source: "test", http: {GET: "/oneOf5", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  """oneOf test with allOf, requiring oneOf collapse"""
  oneOf6: oneOf6_200_response @connect(source: "test", http: {GET: "/oneOf6", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  """Basic anyOf test using the same member schemas"""
  anyOf: anyOf_200_response @connect(source: "test", http: {GET: "/anyOf", headers: [{name: "accept", value: "application/json"}]}, selection: "commonAttribute")
  """Basic anyOf test with different member schemas"""
  anyOf2: anyOf2_200_response @connect(source: "test", http: {GET: "/anyOf2", headers: [{name: "accept", value: "application/json"}]}, selection: "commonAttribute differentAttribute")
  """anyOf test with the same nested member schemas"""
  anyOf3: anyOf3_200_response @connect(source: "test", http: {GET: "/anyOf3", headers: [{name: "accept", value: "application/json"}]}, selection: "commonAttribute { commonAttribute }")
  """anyOf test with different nested member schemas"""
  anyOf4: anyOf4_200_response @connect(source: "test", http: {GET: "/anyOf4", headers: [{name: "accept", value: "application/json"}]}, selection: "commonAttribute { commonAttribute } differentAttribute { commonAttribute }")
  """anyOf test with different nested member schemas, leading to conflict"""
  anyOf5: anyOf5_200_response @connect(source: "test", http: {GET: "/anyOf5", headers: [{name: "accept", value: "application/json"}]}, selection: "commonAttribute")
  """anyOf test with incompatible member schema types"""
  anyOf6: anyOf6_200_response @connect(source: "test", http: {GET: "/anyOf6", headers: [{name: "accept", value: "application/json"}]}, selection: "commonAttribute")
  """anyOf test with some extraneous member schemas"""
  anyOf7: anyOf7_200_response @connect(source: "test", http: {GET: "/anyOf7", headers: [{name: "accept", value: "application/json"}]}, selection: "commonAttribute")
  """anyOf test with no object type member schemas"""
  anyOf8: anyOf8_200_response @connect(source: "test", http: {GET: "/anyOf8", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  """anyOf test with extraneous member schemas with external type"""
  anyOf9: Int @connect(source: "test", http: {GET: "/anyOf9", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  """Basic anyOf test with allOf"""
  anyOf10: anyOf10_200_response @connect(source: "test", http: {GET: "/anyOf10", headers: [{name: "accept", value: "application/json"}]}, selection: "anotherAttribute commonAttribute differentAttribute")
  """anyOf test with allOf, requiring anyOf collapse"""
  anyOf11: anyOf11_200_response @connect(source: "test", http: {GET: "/anyOf11", headers: [{name: "accept", value: "application/json"}]}, selection: "anotherAttribute commonAttribute differentAttribute")
  testLink: String @connect(source: "test", http: {GET: "/testLink", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
  oneOfWithAllOfsAndLink: OneOfWithAllOfsAndLink @connect(source: "test", http: {GET: "/oneOfWithAllOfsAndLink", headers: [{name: "accept", value: "application/json"}]}, selection: "$")
}

union oneOf_200_response = commonAttributeObject | differentAttributeObject

type commonAttributeObject {
  commonAttribute: String
}

type differentAttributeObject {
  differentAttribute: String
}

union oneOf2_200_response = commonAttributeObject | Int_container

type Int_container {
  Int: Int @connect(selection: "$")
}

union oneOf3_200_response = String_container | Int_container

type String_container {
  String: String @connect(selection: "$")
}

union oneOf5_200_response = commonAttributeObject | differentAttributeObject

union oneOf6_200_response = commonAttributeObject | differentAttributeObject | anotherAttributeObject

type anotherAttributeObject {
  anotherAttribute: String
}

type anyOf_200_response {
  commonAttribute: String
}

type anyOf2_200_response {
  commonAttribute: String
  differentAttribute: String
}

type anyOf3_200_response {
  commonAttribute: commonAttributeObject
}

type anyOf4_200_response {
  commonAttribute: commonAttributeObject
  differentAttribute: commonAttributeObject
}

type anyOf5_200_response {
  commonAttribute: JSON
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

type anyOf6_200_response {
  commonAttribute: String
  String: String @connect(selection: "$")
}

type anyOf7_200_response {
  commonAttribute: String
  Float: Float @connect(selection: "$")
}

type anyOf8_200_response {
  Int: Int @connect(selection: "$")
  Float: Float @connect(selection: "$")
}

type anyOf10_200_response {
  anotherAttribute: String
  commonAttribute: String
  differentAttribute: String
}

type anyOf11_200_response {
  anotherAttribute: String
  commonAttribute: String
  differentAttribute: String
}

union OneOfWithAllOfsAndLink = One | Two

type One {
  commonProp: String
  differentOneProp: String
  testLink: String
}

type Two {
  commonProp: String
  differentTwoProp: String
}

input ConnectHTTP {
  GET: String
  HEAD: String
  POST: String
  PUT: String
  PATCH: String
  DELETE: String
  headers: [HTTPHeaderMapping!]
  body: String
  queryParams: String
}

input HTTPHeaderMapping {
  name: String!
  value: String
  from: String
}

input ConnectorErrors {
  message: String
  extensions: String
}

input SourceHTTP {
  baseURL: String!
  headers: [HTTPHeaderMapping!]
  queryParams: String
  errors: ConnectorErrors
  isSuccess: String
}"
`;
