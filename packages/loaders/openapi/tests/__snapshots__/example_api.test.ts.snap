}

"""A company is the employer of many users"""
type company {
  """The identifier of a company"""
  id: UUID
  """The legal name of a company"""
  name: String
  """The legal form of a company"""
  legalForm: String
  """The identifier of the user who is CEO of the company"""
  ceoUsername: String
  """The offices of a company"""
  offices: [address]
  """Allows to fetch the company's CEO user."""
  ceoUser: user @connect(source: "example_api", http: {GET: "/users/{$this.ceoUsername}", headers: [{name: "accept", value: "application/json"}]}, selection: "username\\nname\\naddress {\\n  street\\n  city\\n}\\naddress2 {\\n  street\\n  city\\n}\\nemployerId\\nhobbies\\nstatus\\nnomenclature {\\n  suborder\\n  family\\n  familyCircular {\\n    family\\n    familyCircular\\n  }\\n  genus\\n  species\\n}")
}

