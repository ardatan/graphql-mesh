"""A user represents a natural person"""
type user {
  """The identifier of a user"""
  username: String
  """The legal name of a user"""
  name: String!
  address: address!
  address2: address
  """The identifier of the company a user works for"""
  employerId: String!
  """The hobbies of this user"""
  hobbies: [String]!
  status: query_getUsers_items_status
  nomenclature: query_getUsers_items_nomenclature
  """Allows to fetch the user's employer company."""
  employerCompany: company @connect(source: "example_api", http: {GET: "/companies/{$this.employerId}", headers: [{name: "accept", value: "application/json"}]}, selection: "id\\nname\\nlegalForm\\nceoUsername\\noffices {\\n  street\\n  city\\n}")
  """Allows to fetch the user's friends."""
  friends: [user] @connect(source: "example_api", http: {GET: "/users/{root.$request.path.username}/friends", headers: [{name: "accept", value: "application/json"}]}, selection: "username\\nname\\naddress {\\n  street\\n  city\\n}\\naddress2 {\\n  street\\n  city\\n}\\nemployerId\\nhobbies\\nstatus\\nnomenclature {\\n  suborder\\n  family\\n  familyCircular {\\n    family\\n    familyCircular\\n  }\\n  genus\\n  species\\n}")
}

"""The legal address of a user"""
type address {
  """The street a user lives in"""
  street: String
  """The city a user lives in"""
  city: String
}

enum query_getUsers_items_status {
  staff
  contractor
  alumni
}

