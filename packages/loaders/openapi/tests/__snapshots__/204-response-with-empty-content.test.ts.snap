exports[`204 response with empty content should generate the schema correctly 1`] = `
"schema @source(name: "test", http: {baseURL: "/"}) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect", "@source"]) {
  query: Query
  mutation: Mutation
}

directive @connect(source: String, http: ConnectHTTP, selection: String!, entity: Boolean, errors: ConnectorErrors, isSuccess: String) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHTTP!, errors: ConnectorErrors, isSuccess: String) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

type Query {
  dummy: String @connect(selection: "$(\\"dummy\\")")
}

type Mutation {
  myOperation: Void @connect(source: "test", http: {PUT: "/myoperation"}, selection: "$")
}

"""Represents empty values"""
scalar Void

input ConnectHTTP {
  GET: String
  HEAD: String
  POST: String
  PUT: String
  PATCH: String
  DELETE: String
  headers: [HTTPHeaderMapping!]
  body: String
  queryParams: String
}

input HTTPHeaderMapping {
  name: String!
  value: String
  from: String
}

input ConnectorErrors {
  message: String
  extensions: String
}

input SourceHTTP {
  baseURL: String!
  headers: [HTTPHeaderMapping!]
  queryParams: String
  errors: ConnectorErrors
  isSuccess: String
}"
`;
