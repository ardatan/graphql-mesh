// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Query Params queryParamsSample with invalid param names: queryParamsSample 1`] = `
"schema @source(name: "test", http: {baseURL: "http://localhost:3000"}) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect", "@source"]) @link(url: "https://the-guild.dev/graphql/mesh/spec/v1.0", import: ["@meshRestOptions"]) {
  query: Query
}

directive @connect(source: String, http: ConnectHTTP, selection: String!, entity: Boolean, errors: ConnectorErrors, isSuccess: String) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHTTP!, errors: ConnectorErrors, isSuccess: String) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

directive @meshRestOptions(queryStringOptions: ObjMap, queryStringOptionsByParam: ObjMap, requestBaseBody: ObjMap, timeout: Int, isBinary: Boolean) on FIELD_DEFINITION

type Query {
  test(foo_bar: String): JSON @connect(source: "test", http: {GET: "/test", queryParams: "{\\n  \\"foo:bar\\": $args.foo_bar\\n}"}, selection: "$")
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

input ConnectHTTP {
  GET: String
  HEAD: String
  POST: String
  PUT: String
  PATCH: String
  DELETE: String
  headers: [HTTPHeaderMapping!]
  body: String
  queryParams: String
}

input HTTPHeaderMapping {
  name: String!
  value: String
  from: String
}

input ConnectorErrors {
  message: String
  extensions: String
}

input SourceHTTP {
  baseURL: String!
  headers: [HTTPHeaderMapping!]
  queryParams: String
  errors: ConnectorErrors
  isSuccess: String
}

scalar ObjMap"
`;
