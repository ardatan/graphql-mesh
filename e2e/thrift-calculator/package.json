{
  "name": "@e2e/thrift-calculator",
  "type": "module",
  "private": true,
  "scripts": {
    "codegen": "node -e \"const path=require('path');const {generate}=require('@creditkarma/thrift-typescript');const root=process.cwd();generate({rootDir:root,sourceDir:path.join(root,'services/calculator'),outDir:path.join(root,'services/calculator/__generated__'),target:'thrift-server',files:[path.join(root,'services/calculator/calculator.thrift')]}).then(()=>console.log('codegen ok'))\" && node ../../scripts/patch-thrift-oneway-zip.mjs services/calculator/__generated__/Calculator.ts",
    "patch:oneway-zip": "node ../../scripts/patch-thrift-oneway-zip.mjs services/calculator/__generated__/Calculator.ts"
  },
  "dependencies": {
    "@creditkarma/thrift-server-core": "^1.0.4",
    "@creditkarma/thrift-server-express": "^1.0.4",
    "@creditkarma/thrift-typescript": "^3.7.6",
    "@graphql-hive/gateway": "^3.0.0",
    "@omnigraph/thrift": "^0.12.3",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "graphql": "^16.14.0",
    "thrift": "^0.25.0"
  }
}
