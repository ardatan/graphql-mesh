input TitleFilter @join__type(graph:EMPLOYEES) {and:[TitleFilter!] or:[TitleFilter!] not:TitleFilter empNo:IntFilter title:StringFilter fromDate:StringFilter toDate:StringFilter employee:EmployeeFilter}
