    dept_name: \$args.input.deptName
  """, where: """
  
    dept_no: \$args.id
  """, selection: """
    department {
      id: dept_no
      deptName: dept_name
    }
  """})
  deleteDepartment(id: ID!): DeleteDepartmentPayload! @join__directive(graphs: [EMPLOYEES], name: "sql", args: {table: "departments", kind: "DELETE", where: """
  
    dept_no: \$args.id
  """, selection: """
    ok: \$affectedRows
    affectedRows: \$affectedRows
  """})
  createDeptEmp(input: CreateDeptEmpInput!): DeptEmpPayload! @join__directive(graphs: [EMPLOYEES], name: "sql", args: {table: "dept_emp", kind: "INSERT", set: """
    emp_no: \$args.input.empNo
    dept_no: \$args.input.deptNo
    from_date: \$args.input.fromDate
    to_date: \$args.input.toDate
  """, selection: """
    deptEmp {
      empNo: emp_no
      deptNo: dept_no
      fromDate: from_date
      toDate: to_date
    }
  """})
  createDeptManager(input: CreateDeptManagerInput!): DeptManagerPayload! @join__directive(graphs: [EMPLOYEES], name: "sql", args: {table: "dept_manager", kind: "INSERT", set: """
    emp_no: \$args.input.empNo
    dept_no: \$args.input.deptNo
    from_date: \$args.input.fromDate
    to_date: \$args.input.toDate
  """, selection: """
    deptManager {
      empNo: emp_no
      deptNo: dept_no
      fromDate: from_date
      toDate: to_date
    }
  """})
  createEmployee(input: CreateEmployeeInput!): EmployeePayload! @join__directive(graphs: [EMPLOYEES], name: "sql", args: {table: "employees", kind: "INSERT", set: """
    emp_no: \$args.input.id
    birth_date: \$args.input.birthDate
    first_name: \$args.input.firstName
    last_name: \$args.input.lastName
    gender: \$args.input.gender
    hire_date: \$args.input.hireDate
  """, selection: """
    employee {
      id: emp_no
      birthDate: birth_date
      firstName: first_name
      lastName: last_name
      gender: gender
      hireDate: hire_date
    }
  """})
  updateEmployee(id: ID!, input: UpdateEmployeeInput!): EmployeePayload! @join__directive(graphs: [EMPLOYEES], name: "sql", args: {table: "employees", kind: "UPDATE", set: """
    birth_date: \$args.input.birthDate
    first_name: \$args.input.firstName
    last_name: \$args.input.lastName
    gender: \$args.input.gender
    hire_date: \$args.input.hireDate
  """, where: """
  
    emp_no: \$args.id
  """, selection: """
    employee {
      id: emp_no
      birthDate: birth_date
      firstName: first_name
      lastName: last_name
      gender: gender
      hireDate: hire_date
    }
  """})
  deleteEmployee(id: ID!): DeleteEmployeePayload! @join__directive(graphs: [EMPLOYEES], name: "sql", args: {table: "employees", kind: "DELETE", where: """
  
    emp_no: \$args.id
  """, selection: """
    ok: \$affectedRows
    affectedRows: \$affectedRows
  """})
  createSalary(input: CreateSalaryInput!): SalaryPayload! @join__directive(graphs: [EMPLOYEES], name: "sql", args: {table: "salaries", kind: "INSERT", set: """
    emp_no: \$args.input.empNo
    salary: \$args.input.salary
    from_date: \$args.input.fromDate
    to_date: \$args.input.toDate
  """, selection: """
    salary {
      empNo: emp_no
      salary: salary
      fromDate: from_date
      toDate: to_date
    }
  """})
  createTitle(input: CreateTitleInput!): TitlePayload! @join__directive(graphs: [EMPLOYEES], name: "sql", args: {table: "titles", kind: "INSERT", set: """
    emp_no: \$args.input.empNo
    title: \$args.input.title
    from_date: \$args.input.fromDate
    to_date: \$args.input.toDate
  """, selection: """
    title {
      empNo: emp_no
      title: title
      fromDate: from_date
      toDate: to_date
    }
  """})
}

type DepartmentPayload @join__type(graph: EMPLOYEES) {
  department: Department
}

type DeleteDepartmentPayload @join__type(graph: EMPLOYEES) {
  ok: Boolean!
  affectedRows: Int!
}

type DeptEmpPayload @join__type(graph: EMPLOYEES) {
  deptEmp: DeptEmp
}

type DeptManagerPayload @join__type(graph: EMPLOYEES) {
  deptManager: DeptManager
}

type EmployeePayload @join__type(graph: EMPLOYEES) {
  employee: Employee
}

type DeleteEmployeePayload @join__type(graph: EMPLOYEES) {
  ok: Boolean!
  affectedRows: Int!
}

type SalaryPayload @join__type(graph: EMPLOYEES) {
  salary: Salary
}

type TitlePayload @join__type(graph: EMPLOYEES) {
  title: Title
}

