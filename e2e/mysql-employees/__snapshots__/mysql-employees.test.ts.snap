enum EmployeeOrderBy @join__type(graph:EMPLOYEES) {ID_ASC @join__enumValue(graph:EMPLOYEES) ID_DESC @join__enumValue(graph:EMPLOYEES) BIRTH_DATE_ASC @join__enumValue(graph:EMPLOYEES) BIRTH_DATE_DESC @join__enumValue(graph:EMPLOYEES) FIRST_NAME_ASC @join__enumValue(graph:EMPLOYEES) FIRST_NAME_DESC @join__enumValue(graph:EMPLOYEES) LAST_NAME_ASC @join__enumValue(graph:EMPLOYEES) LAST_NAME_DESC @join__enumValue(graph:EMPLOYEES) GENDER_ASC @join__enumValue(graph:EMPLOYEES) GENDER_DESC @join__enumValue(graph:EMPLOYEES) HIRE_DATE_ASC @join__enumValue(graph:EMPLOYEES) HIRE_DATE_DESC @join__enumValue(graph:EMPLOYEES)}
enum SalaryOrderBy @join__type(graph:EMPLOYEES) {EMP_NO_ASC @join__enumValue(graph:EMPLOYEES) EMP_NO_DESC @join__enumValue(graph:EMPLOYEES) SALARY_ASC @join__enumValue(graph:EMPLOYEES) SALARY_DESC @join__enumValue(graph:EMPLOYEES) FROM_DATE_ASC @join__enumValue(graph:EMPLOYEES) FROM_DATE_DESC @join__enumValue(graph:EMPLOYEES) TO_DATE_ASC @join__enumValue(graph:EMPLOYEES) TO_DATE_DESC @join__enumValue(graph:EMPLOYEES)}
