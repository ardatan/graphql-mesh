input DeptEmpFilter @join__type(graph:EMPLOYEES) {and:[DeptEmpFilter!] or:[DeptEmpFilter!] not:DeptEmpFilter empNo:IntFilter deptNo:StringFilter fromDate:StringFilter toDate:StringFilter employee:EmployeeFilter department:DepartmentFilter}
input IntFilter @join__type(graph:EMPLOYEES) {eq:Int ne:Int in:[Int!] nin:[Int!] lt:Int lte:Int gt:Int gte:Int isNull:Boolean}
input StringFilter @join__type(graph:EMPLOYEES) {eq:String ne:String in:[String!] nin:[String!] lt:String lte:String gt:String gte:String includes:String startsWith:String endsWith:String like:String ilike:String isNull:Boolean}
input EmployeeFilter @join__type(graph:EMPLOYEES) {and:[EmployeeFilter!] or:[EmployeeFilter!] not:EmployeeFilter id:StringFilter birthDate:StringFilter firstName:StringFilter lastName:StringFilter gender:StringFilter hireDate:StringFilter departments:DepartmentFilter departmentsByDeptManagerEmpNoAndDeptNo:DepartmentFilter}
