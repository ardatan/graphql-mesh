input DeptManagerFilter @join__type(graph:EMPLOYEES) {and:[DeptManagerFilter!] or:[DeptManagerFilter!] not:DeptManagerFilter empNo:IntFilter deptNo:StringFilter fromDate:StringFilter toDate:StringFilter employee:EmployeeFilter department:DepartmentFilter}
