  HELLOER @join__graph(name: "helloer", url: "http://localhost:<helloer_port>/graphql")
}

scalar TransportOptions @join__type(graph: HELLOER)

type Query @join__type(graph: GREETINGS) @join__type(graph: HELLOER) {
  greet(name: String!): greet_200_response @join__field(graph: GREETINGS) @join__directive(graphs: [GREETINGS], name: "connect", args: {source: "greetings", http: {GET: "/greet/{$args.name}", headers: [{name: "accept", value: "application/json"}]}, selection: "greeting"})
  hello: String! @join__field(graph: HELLOER)
}

type greet_200_response @join__type(graph: GREETINGS) {
  greeting: String!
}

scalar ObjMap

directive @transport(subgraph: String, kind: String, location: String, headers: ObjMap, queryStringOptions: ObjMap, queryParams: ObjMap) repeatable on SCHEMA

directive @join__directive(graphs: [join__Graph!], name: String!, args: join__DirectiveArguments) repeatable on SCHEMA | OBJECT | INTERFACE | FIELD_DEFINITION

