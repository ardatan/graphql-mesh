// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`should compose the appropriate schema 1`] = `
"schema @link(url: "https://specs.apollo.dev/link/v1.0") @link(url: "https://specs.apollo.dev/join/v0.3", for: EXECUTION) @link(url: "https://specs.graphql-mesh.com/sql/v0.1", import: ["@transport", "@sql"]) @transport(subgraph: "Geo", kind: "sql", location: "postgres://postgres:docker@localhost:<geodb_port>/postgres") {
  query: Query
  mutation: Mutation
}

directive @join__enumValue(graph: join__Graph!) repeatable on ENUM_VALUE

directive @join__graph(name: String!, url: String!) on ENUM_VALUE

directive @join__field(graph: join__Graph, requires: join__FieldSet, provides: join__FieldSet, type: String, external: Boolean, override: String, usedOverridden: Boolean) repeatable on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

directive @join__implements(graph: join__Graph!, interface: String!) repeatable on OBJECT | INTERFACE

directive @join__type(graph: join__Graph!, key: join__FieldSet, extension: Boolean! = false, resolvable: Boolean! = true, isInterfaceObject: Boolean! = false) repeatable on OBJECT | INTERFACE | UNION | ENUM | INPUT_OBJECT | SCALAR

directive @join__unionMember(graph: join__Graph!, member: String!) repeatable on UNION

scalar join__FieldSet

directive @link(url: String, as: String, for: link__Purpose, import: [link__Import]) repeatable on SCHEMA

scalar link__Import

enum link__Purpose {
  """
  \`SECURITY\` features provide metadata necessary to securely resolve fields.
  """
  SECURITY
  """
  \`EXECUTION\` features provide metadata necessary for operation execution.
  """
  EXECUTION
}

enum join__Graph {
  GEO @join__graph(name: "Geo", url: "postgres://postgres:docker@localhost:<geodb_port>/postgres")
}

directive @transport(subgraph: String!, kind: String!, location: String, headers: [[String]], options: TransportOptions) repeatable on SCHEMA

directive @sql(subgraph: String, table: String!, kind: SqlKind!, where: String, orderBy: String, limit: String, offset: String, first: String, after: String, set: String, selection: String, through: String) repeatable on FIELD_DEFINITION | OBJECT

scalar TransportOptions @join__type(graph: GEO)

type Query @join__type(graph: GEO) {
  city(id: ID!): City @sql(subgraph: "Geo", table: "city", kind: ROW, where: "\\n  id: $args.id", selection: "  id: id\\n  name: name\\n  countrycode: countrycode\\n  district: district\\n  population: population")
  cities(where: CityFilter, orderBy: [CityOrderBy!], limit: Int = 10, offset: Int = 0): [City!]! @sql(subgraph: "Geo", table: "city", kind: ROWS, where: "$args.where", orderBy: "$args.orderBy", limit: "$args.limit", offset: "$args.offset", selection: "  id: id\\n  name: name\\n  countrycode: countrycode\\n  district: district\\n  population: population")
  allCities(where: CityFilter, orderBy: [CityOrderBy!], first: Int, after: String): CityConnection! @sql(subgraph: "Geo", table: "city", kind: CONNECTION, where: "$args.where", orderBy: "$args.orderBy", first: "$args.first", after: "$args.after", selection: "  nodes {\\n    id: id\\n    name: name\\n    countrycode: countrycode\\n    district: district\\n    population: population\\n  }\\n  edges {\\n    cursor: $cursor\\n    node {\\n      id: id\\n      name: name\\n      countrycode: countrycode\\n      district: district\\n      population: population\\n    }\\n  }\\n  pageInfo {\\n    hasNextPage: $hasNextPage\\n    hasPreviousPage: $hasPreviousPage\\n    startCursor: $startCursor\\n    endCursor: $endCursor\\n  }\\n  totalCount: $totalCount")
  citiesCount(where: CityFilter): Int! @sql(subgraph: "Geo", table: "city", kind: COUNT, where: "$args.where", selection: "\\n  $")
  country(id: ID!): Country @sql(subgraph: "Geo", table: "country", kind: ROW, where: "\\n  code: $args.id", selection: "  id: code\\n  name: name\\n  continent: continent\\n  region: region\\n  surfacearea: surfacearea\\n  indepyear: indepyear\\n  population: population\\n  lifeexpectancy: lifeexpectancy\\n  gnp: gnp\\n  gnpold: gnpold\\n  localname: localname\\n  governmentform: governmentform\\n  headofstate: headofstate\\n  capital: capital\\n  code2: code2")
  countries(where: CountryFilter, orderBy: [CountryOrderBy!], limit: Int = 10, offset: Int = 0): [Country!]! @sql(subgraph: "Geo", table: "country", kind: ROWS, where: "$args.where", orderBy: "$args.orderBy", limit: "$args.limit", offset: "$args.offset", selection: "  id: code\\n  name: name\\n  continent: continent\\n  region: region\\n  surfacearea: surfacearea\\n  indepyear: indepyear\\n  population: population\\n  lifeexpectancy: lifeexpectancy\\n  gnp: gnp\\n  gnpold: gnpold\\n  localname: localname\\n  governmentform: governmentform\\n  headofstate: headofstate\\n  capital: capital\\n  code2: code2")
  allCountries(where: CountryFilter, orderBy: [CountryOrderBy!], first: Int, after: String): CountryConnection! @sql(subgraph: "Geo", table: "country", kind: CONNECTION, where: "$args.where", orderBy: "$args.orderBy", first: "$args.first", after: "$args.after", selection: "  nodes {\\n    id: code\\n    name: name\\n    continent: continent\\n    region: region\\n    surfacearea: surfacearea\\n    indepyear: indepyear\\n    population: population\\n    lifeexpectancy: lifeexpectancy\\n    gnp: gnp\\n    gnpold: gnpold\\n    localname: localname\\n    governmentform: governmentform\\n    headofstate: headofstate\\n    capital: capital\\n    code2: code2\\n  }\\n  edges {\\n    cursor: $cursor\\n    node {\\n      id: code\\n      name: name\\n      continent: continent\\n      region: region\\n      surfacearea: surfacearea\\n      indepyear: indepyear\\n      population: population\\n      lifeexpectancy: lifeexpectancy\\n      gnp: gnp\\n      gnpold: gnpold\\n      localname: localname\\n      governmentform: governmentform\\n      headofstate: headofstate\\n      capital: capital\\n      code2: code2\\n    }\\n  }\\n  pageInfo {\\n    hasNextPage: $hasNextPage\\n    hasPreviousPage: $hasPreviousPage\\n    startCursor: $startCursor\\n    endCursor: $endCursor\\n  }\\n  totalCount: $totalCount")
  countriesCount(where: CountryFilter): Int! @sql(subgraph: "Geo", table: "country", kind: COUNT, where: "$args.where", selection: "\\n  $")
  countrylanguages(where: CountrylanguageFilter, orderBy: [CountrylanguageOrderBy!], limit: Int = 10, offset: Int = 0): [Countrylanguage!]! @sql(subgraph: "Geo", table: "countrylanguage", kind: ROWS, where: "$args.where", orderBy: "$args.orderBy", limit: "$args.limit", offset: "$args.offset", selection: "  countrycode: countrycode\\n  language: language\\n  isofficial: isofficial\\n  percentage: percentage")
  allCountrylanguages(where: CountrylanguageFilter, orderBy: [CountrylanguageOrderBy!], first: Int, after: String): CountrylanguageConnection! @sql(subgraph: "Geo", table: "countrylanguage", kind: CONNECTION, where: "$args.where", orderBy: "$args.orderBy", first: "$args.first", after: "$args.after", selection: "  nodes {\\n    countrycode: countrycode\\n    language: language\\n    isofficial: isofficial\\n    percentage: percentage\\n  }\\n  edges {\\n    cursor: $cursor\\n    node {\\n      countrycode: countrycode\\n      language: language\\n      isofficial: isofficial\\n      percentage: percentage\\n    }\\n  }\\n  pageInfo {\\n    hasNextPage: $hasNextPage\\n    hasPreviousPage: $hasPreviousPage\\n    startCursor: $startCursor\\n    endCursor: $endCursor\\n  }\\n  totalCount: $totalCount")
  countrylanguagesCount(where: CountrylanguageFilter): Int! @sql(subgraph: "Geo", table: "countrylanguage", kind: COUNT, where: "$args.where", selection: "\\n  $")
}

type City @sql(subgraph: "Geo", table: "city", kind: ROW, where: """id: $this.id""", selection: """
id: id
name: name
countrycode: countrycode
district: district
population: population
""") @join__type(graph: GEO, key: "id") {
  id: ID!
  name: String!
  countrycode: String!
  district: String!
  population: Int!
  countries(where: CountryFilter, orderBy: [CountryOrderBy!], limit: Int, offset: Int): [Country!]! @sql(subgraph: "Geo", table: "country", kind: ROWS, where: "  capital: $this.id\\n  ...$args.where", orderBy: "$args.orderBy", limit: "$args.limit", offset: "$args.offset", selection: "  id: code\\n  name: name\\n  continent: continent\\n  region: region\\n  surfacearea: surfacearea\\n  indepyear: indepyear\\n  population: population\\n  lifeexpectancy: lifeexpectancy\\n  gnp: gnp\\n  gnpold: gnpold\\n  localname: localname\\n  governmentform: governmentform\\n  headofstate: headofstate\\n  capital: capital\\n  code2: code2")
}

type Country @sql(subgraph: "Geo", table: "country", kind: ROW, where: """code: $this.id""", selection: """
id: code
name: name
continent: continent
region: region
surfacearea: surfacearea
indepyear: indepyear
population: population
lifeexpectancy: lifeexpectancy
gnp: gnp
gnpold: gnpold
localname: localname
governmentform: governmentform
headofstate: headofstate
capital: capital
code2: code2
""") @join__type(graph: GEO, key: "id") {
  id: ID!
  name: String!
  continent: String!
  region: String!
  surfacearea: Float!
  indepyear: Int
  population: Int!
  lifeexpectancy: Float
  gnp: Float
  gnpold: Float
  localname: String!
  governmentform: String!
  headofstate: String
  capital: Int
  code2: String!
  city: City @sql(subgraph: "Geo", table: "city", kind: ROW, where: "\\n  id: $this.capital", selection: "  id: id\\n  name: name\\n  countrycode: countrycode\\n  district: district\\n  population: population")
  countrylanguages(where: CountrylanguageFilter, orderBy: [CountrylanguageOrderBy!], limit: Int, offset: Int): [Countrylanguage!]! @sql(subgraph: "Geo", table: "countrylanguage", kind: ROWS, where: "  countrycode: $this.id\\n  ...$args.where", orderBy: "$args.orderBy", limit: "$args.limit", offset: "$args.offset", selection: "  countrycode: countrycode\\n  language: language\\n  isofficial: isofficial\\n  percentage: percentage")
}

type Countrylanguage @sql(subgraph: "Geo", table: "countrylanguage", kind: ROW, where: """
countrycode: $this.countrycode
language: $this.language
""", selection: """
countrycode: countrycode
language: language
isofficial: isofficial
percentage: percentage
""") @join__type(graph: GEO, key: "countrycode language") {
  countrycode: String!
  language: String!
  isofficial: Boolean!
  percentage: Float!
  country: Country @sql(subgraph: "Geo", table: "country", kind: ROW, where: "\\n  code: $this.countrycode", selection: "  id: code\\n  name: name\\n  continent: continent\\n  region: region\\n  surfacearea: surfacearea\\n  indepyear: indepyear\\n  population: population\\n  lifeexpectancy: lifeexpectancy\\n  gnp: gnp\\n  gnpold: gnpold\\n  localname: localname\\n  governmentform: governmentform\\n  headofstate: headofstate\\n  capital: capital\\n  code2: code2")
}

