type Mutation @join__type(graph: GEO) {
  createCity(input: CreateCityInput!): CityPayload! @sql(subgraph: "Geo", table: "city", kind: INSERT, set: "  id: $args.input.id\\n  name: $args.input.name\\n  countrycode: $args.input.countrycode\\n  district: $args.input.district\\n  population: $args.input.population", selection: "  city {\\n    id: id\\n    name: name\\n    countrycode: countrycode\\n    district: district\\n    population: population\\n  }")
  updateCity(id: ID!, input: UpdateCityInput!): CityPayload! @sql(subgraph: "Geo", table: "city", kind: UPDATE, set: "  name: $args.input.name\\n  countrycode: $args.input.countrycode\\n  district: $args.input.district\\n  population: $args.input.population", where: "\\n  id: $args.id", selection: "  city {\\n    id: id\\n    name: name\\n    countrycode: countrycode\\n    district: district\\n    population: population\\n  }")
  deleteCity(id: ID!): DeleteCityPayload! @sql(subgraph: "Geo", table: "city", kind: DELETE, where: "\\n  id: $args.id", selection: "  ok: $affectedRows\\n  affectedRows: $affectedRows")
  createCountry(input: CreateCountryInput!): CountryPayload! @sql(subgraph: "Geo", table: "country", kind: INSERT, set: "  code: $args.input.id\\n  name: $args.input.name\\n  continent: $args.input.continent\\n  region: $args.input.region\\n  surfacearea: $args.input.surfacearea\\n  indepyear: $args.input.indepyear\\n  population: $args.input.population\\n  lifeexpectancy: $args.input.lifeexpectancy\\n  gnp: $args.input.gnp\\n  gnpold: $args.input.gnpold\\n  localname: $args.input.localname\\n  governmentform: $args.input.governmentform\\n  headofstate: $args.input.headofstate\\n  capital: $args.input.capital\\n  code2: $args.input.code2", selection: "  country {\\n    id: code\\n    name: name\\n    continent: continent\\n    region: region\\n    surfacearea: surfacearea\\n    indepyear: indepyear\\n    population: population\\n    lifeexpectancy: lifeexpectancy\\n    gnp: gnp\\n    gnpold: gnpold\\n    localname: localname\\n    governmentform: governmentform\\n    headofstate: headofstate\\n    capital: capital\\n    code2: code2\\n  }")
  updateCountry(id: ID!, input: UpdateCountryInput!): CountryPayload! @sql(subgraph: "Geo", table: "country", kind: UPDATE, set: "  name: $args.input.name\\n  continent: $args.input.continent\\n  region: $args.input.region\\n  surfacearea: $args.input.surfacearea\\n  indepyear: $args.input.indepyear\\n  population: $args.input.population\\n  lifeexpectancy: $args.input.lifeexpectancy\\n  gnp: $args.input.gnp\\n  gnpold: $args.input.gnpold\\n  localname: $args.input.localname\\n  governmentform: $args.input.governmentform\\n  headofstate: $args.input.headofstate\\n  capital: $args.input.capital\\n  code2: $args.input.code2", where: "\\n  code: $args.id", selection: "  country {\\n    id: code\\n    name: name\\n    continent: continent\\n    region: region\\n    surfacearea: surfacearea\\n    indepyear: indepyear\\n    population: population\\n    lifeexpectancy: lifeexpectancy\\n    gnp: gnp\\n    gnpold: gnpold\\n    localname: localname\\n    governmentform: governmentform\\n    headofstate: headofstate\\n    capital: capital\\n    code2: code2\\n  }")
  deleteCountry(id: ID!): DeleteCountryPayload! @sql(subgraph: "Geo", table: "country", kind: DELETE, where: "\\n  code: $args.id", selection: "  ok: $affectedRows\\n  affectedRows: $affectedRows")
  createCountrylanguage(input: CreateCountrylanguageInput!): CountrylanguagePayload! @sql(subgraph: "Geo", table: "countrylanguage", kind: INSERT, set: "  countrycode: $args.input.countrycode\\n  language: $args.input.language\\n  isofficial: $args.input.isofficial\\n  percentage: $args.input.percentage", selection: "  countrylanguage {\\n    countrycode: countrycode\\n    language: language\\n    isofficial: isofficial\\n    percentage: percentage\\n  }")
}

