exports[`should execute cities and country capital 1`] = `
{
  "data": {
    "cities": [
      {
        "countrycode": "AFG",
        "district": "Kabol",
        "id": "1",
        "name": "Kabul",
      },
      {
        "countrycode": "AFG",
        "district": "Qandahar",
        "id": "2",
        "name": "Qandahar",
      },
      {
        "countrycode": "AFG",
        "district": "Herat",
        "id": "3",
        "name": "Herat",
      },
    ],
    "country": {
      "city": {
        "name": "Amsterdam",
      },
      "continent": "Europe",
      "id": "NLD",
      "name": "Netherlands",
    },
  },
}
`;
