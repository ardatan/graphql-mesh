  selection: String!
  entity: Boolean
  errors: ConnectorErrors
  isSuccess: String
) repeatable on FIELD_DEFINITION | OBJECT

directive @extraSchemaDefinitionDirective(directives: _DirectiveExtensions) repeatable on OBJECT

