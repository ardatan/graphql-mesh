    selection: "__typename: $status->match([200, \\"User\\"], [202, \\"AsyncJob\\"], [400, \\"Error\\"], [@, \\"User\\"])\\nid\\nname\\nemail\\nasynchronous_job_id\\nstatus\\nestimated_completion\\nerror\\ncode"
    isSuccess: "$status->match([200, true], [202, true], [400, true], [@, false])"
