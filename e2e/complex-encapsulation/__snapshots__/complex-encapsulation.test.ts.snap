exports[`should compose the appropriate schema 1`] = `
"schema @link(url: "https://specs.apollo.dev/link/v1.0") @link(url: "https://specs.apollo.dev/join/v0.3", for: EXECUTION) @link(url: "https://specs.apollo.dev/inaccessible/v0.2", for: SECURITY) @link(
  url: "https://the-guild.dev/graphql/mesh/spec/v1.0"
  import: ["@merge", "@resolveTo", "@source", "@resolveRootField", "@extraSchemaDefinitionDirective"]
) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect"]) {
  query: Query
}

directive @join__enumValue(graph: join__Graph!) repeatable on ENUM_VALUE

directive @join__graph(name: String!, url: String!) on ENUM_VALUE

directive @join__field(
  graph: join__Graph
  requires: join__FieldSet
  provides: join__FieldSet
  type: String
  external: Boolean
  override: String
  usedOverridden: Boolean
) repeatable on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

directive @join__implements(graph: join__Graph!, interface: String!) repeatable on OBJECT | INTERFACE

directive @join__type(
  graph: join__Graph!
  key: join__FieldSet
  extension: Boolean! = false
  resolvable: Boolean! = true
  isInterfaceObject: Boolean! = false
) repeatable on OBJECT | INTERFACE | UNION | ENUM | INPUT_OBJECT | SCALAR

directive @join__unionMember(graph: join__Graph!, member: String!) repeatable on UNION

scalar join__FieldSet

directive @link(url: String, as: String, for: link__Purpose, import: [link__Import]) repeatable on SCHEMA

scalar link__Import

enum link__Purpose {
  """
  \`SECURITY\` features provide metadata necessary to securely resolve fields.
  """
  SECURITY
  """
  \`EXECUTION\` features provide metadata necessary for operation execution.
  """
  EXECUTION
}

directive @inaccessible on FIELD_DEFINITION | OBJECT | INTERFACE | UNION | ENUM | ENUM_VALUE | SCALAR | INPUT_OBJECT | INPUT_FIELD_DEFINITION | ARGUMENT_DEFINITION

enum join__Graph {
  SUBGRAPH_A @join__graph(name: "subgraph-a", url: "http://localhost:<subgraph-a_port>/graphql")
  SUBGRAPH_B @join__graph(name: "subgraph-b", url: "http://localhost:<subgraph-b_port>")
}

directive @merge(
  subgraph: String!
  argsExpr: String
  keyArg: String
  keyField: String
  key: [String]
  additionalArgs: String
) repeatable on FIELD_DEFINITION

directive @resolveTo(
  additionalArgs: SubgraphAResolveToSourceArgs
  filterBy: String
  keyField: String
  keysArg: String
  pubsubTopic: String
  requiredSelectionSet: String
  result: String
  resultType: String
  sourceArgs: SubgraphAResolveToSourceArgs
  sourceFieldName: String
  sourceName: String
  sourceSelectionSet: String
  sourceTypeName: String
  valueKeyField: String
) on FIELD_DEFINITION

directive @source(name: String!, type: String, subgraph: String!) repeatable on SCALAR | OBJECT | FIELD_DEFINITION | ARGUMENT_DEFINITION | INTERFACE | UNION | ENUM | ENUM_VALUE | INPUT_OBJECT | INPUT_FIELD_DEFINITION

directive @resolveRootField(subgraph: String, field: String) repeatable on FIELD_DEFINITION | ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION

directive @connect(
  source: String
  http: ConnectHTTP
  selection: String!
  entity: Boolean
  errors: ConnectorErrors
  isSuccess: String
) repeatable on FIELD_DEFINITION | OBJECT

directive @extraSchemaDefinitionDirective(directives: _DirectiveExtensions) repeatable on OBJECT

scalar SubgraphAResolveToSourceArgs @join__type(graph: SUBGRAPH_A)

scalar SubgraphBResolveToSourceArgs @join__type(graph: SUBGRAPH_B)

scalar _DirectiveExtensions @join__type(graph: SUBGRAPH_B)

type Query @extraSchemaDefinitionDirective(
  directives: {source: [{name: "subgraph-b", http: {baseURL: "http://localhost:<subgraph-b_port>", headers: [{name: "x-custom-header", value: "{$args.xCustomHeader}"}]}}], transport: [{subgraph: "subgraph-b", kind: "rest", location: "http://localhost:<subgraph-b_port>"}]}
) @join__type(graph: SUBGRAPH_A) @join__type(graph: SUBGRAPH_B) {
  _encapsulated_SubgraphA_foo(id: ID!): SubgraphAFoo @source(name: "foo", type: "Foo", subgraph: "subgraph-a") @merge(subgraph: "subgraph-a", keyField: "id", argsExpr: "id: $key.id") @join__field(graph: SUBGRAPH_A) @inaccessible
  _encapsulated_SubgraphA_echoString(argument: String): String @source(name: "echoString", type: "String", subgraph: "subgraph-a") @join__field(graph: SUBGRAPH_A) @inaccessible
  _encapsulated_SubgraphA_echoInt(argument: Int): Int @source(name: "echoInt", type: "Int", subgraph: "subgraph-a") @join__field(graph: SUBGRAPH_A) @inaccessible
  _encapsulated_SubgraphA_echoBoolean(argument: Boolean): Boolean @source(name: "echoBoolean", type: "Boolean", subgraph: "subgraph-a") @join__field(graph: SUBGRAPH_A) @inaccessible
  SubgraphA: SubgraphASubgraphAQuery! @resolveTo(
    sourceName: "subgraph-a"
    sourceTypeName: "Query"
    sourceFieldName: "__typename"
  ) @join__field(graph: SUBGRAPH_A)
  SubgraphB: SubgraphBSubgraphBQuery! @connect(source: "subgraph-b", selection: "$({})") @join__field(graph: SUBGRAPH_B)
}

type SubgraphAFoo @source(name: "Foo", subgraph: "subgraph-a") @join__type(graph: SUBGRAPH_A, key: "id") {
  id: ID!
  name: String
}

type SubgraphASubgraphAQuery @join__type(graph: SUBGRAPH_A) {
  foo(id: ID!): SubgraphAFoo @source(name: "foo", type: "Foo", subgraph: "subgraph-a") @merge(subgraph: "subgraph-a", keyField: "id", argsExpr: "id: $key.id") @resolveTo(
    sourceName: "subgraph-a"
    sourceTypeName: "Query"
    sourceFieldName: "_encapsulated_SubgraphA_foo"
    sourceArgs: {id: "{args.id}"}
