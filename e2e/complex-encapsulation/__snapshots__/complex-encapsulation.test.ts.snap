  echoString(argument: String): String @resolveTo(
    sourceName: "subgraph-a"
    sourceTypeName: "Query"
    sourceFieldName: "_encapsulated_SubgraphA_echoString"
    sourceArgs: {argument: "{args.argument}"}
  )
  echoInt(argument: Int): Int @resolveTo(
    sourceName: "subgraph-a"
    sourceTypeName: "Query"
    sourceFieldName: "_encapsulated_SubgraphA_echoInt"
    sourceArgs: {argument: "{args.argument}"}
  )
  echoBoolean(argument: Boolean): Boolean @resolveTo(
    sourceName: "subgraph-a"
    sourceTypeName: "Query"
    sourceFieldName: "_encapsulated_SubgraphA_echoBoolean"
    sourceArgs: {argument: "{args.argument}"}
  )
}

type SubgraphBSubgraphBQuery @join__type(graph: SUBGRAPH_B) {
  headers(xCustomHeader: String): SubgraphBheaders_200_response @connect(
    source: "subgraph-b"
    http: {GET: "/headers", headers: [{name: "accept", value: "application/json"}]}
    selection: "x_custom_header: \\"x-custom-header\\""
  )
}

type SubgraphBheaders_200_response @join__type(graph: SUBGRAPH_B) {
  x_custom_header: String @resolveRootField(subgraph: "subgraph-b", field: "x-custom-header")
}

input ConnectHTTP @join__type(graph: SUBGRAPH_B) {
  GET: String
  HEAD: String
  POST: String
  PUT: String
  PATCH: String
  DELETE: String
  headers: [HTTPHeaderMapping!]
  body: String
  queryParams: String
}

input HTTPHeaderMapping @join__type(graph: SUBGRAPH_B) {
  name: String!
  value: String
  from: String
}

input ConnectorErrors @join__type(graph: SUBGRAPH_B) {
  message: String
  extensions: String
}
"
`;
