{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observation",
  "type": "object",
  "description": "Observation field set from examples/json-schema-fhir/fhir.schema.json (see patient.json). Shared FHIR-like `string` scalar with pattern across subgraphs.",
  "properties": {
    "id": {
      "title": "string",
      "type": "string",
      "pattern": "[ \\r\\n\\t\\S]+"
    },
    "status": {
      "title": "string",
      "type": "string",
      "pattern": "[ \\r\\n\\t\\S]+"
    },
    "subject": {
      "title": "Reference",
      "type": "object",
      "description": "FHIR Reference (reference/type/display). Full #/definitions/Reference pulls Extension.",
      "properties": {
        "reference": {
          "title": "string",
          "type": "string",
          "pattern": "[ \\r\\n\\t\\S]+"
        },
        "type": {
          "title": "string",
          "type": "string",
          "pattern": "[ \\r\\n\\t\\S]+"
        },
        "display": {
          "title": "string",
          "type": "string",
          "pattern": "[ \\r\\n\\t\\S]+"
        }
      }
    }
  },
  "required": [
    "id"
  ]
}
