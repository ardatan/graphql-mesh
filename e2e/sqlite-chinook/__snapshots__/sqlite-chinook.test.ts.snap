  deleteTrack(id: ID!): DeleteTrackPayload! @sql(subgraph: "chinook", table: "tracks", kind: DELETE, args: "  where {\\n    TrackId: $args.id\\n  }", selection: "  ok: $affectedRows\\n  affectedRows: $affectedRows")
