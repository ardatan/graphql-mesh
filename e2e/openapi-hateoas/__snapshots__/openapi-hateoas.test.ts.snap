// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`OpenAPI HATEOAS should compose 1`] = `
"schema @link(url: "https://specs.apollo.dev/link/v1.0") @link(url: "https://specs.apollo.dev/join/v0.3", for: EXECUTION) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect"]) @link(
  url: "https://the-guild.dev/graphql/mesh/spec/v1.0"
  import: ["@discriminator", "@extraSchemaDefinitionDirective", "@merge"]
) {
  query: Query
}

directive @join__enumValue(graph: join__Graph!) repeatable on ENUM_VALUE

directive @join__graph(name: String!, url: String!) on ENUM_VALUE

directive @join__field(
  graph: join__Graph
  requires: join__FieldSet
  provides: join__FieldSet
  type: String
  external: Boolean
  override: String
  usedOverridden: Boolean
) repeatable on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

directive @join__implements(graph: join__Graph!, interface: String!) repeatable on OBJECT | INTERFACE

directive @join__type(
  graph: join__Graph!
  key: join__FieldSet
  extension: Boolean! = false
  resolvable: Boolean! = true
  isInterfaceObject: Boolean! = false
) repeatable on OBJECT | INTERFACE | UNION | ENUM | INPUT_OBJECT | SCALAR

directive @join__unionMember(graph: join__Graph!, member: String!) repeatable on UNION

scalar join__FieldSet

directive @link(url: String, as: String, for: link__Purpose, import: [link__Import]) repeatable on SCHEMA

scalar link__Import

enum link__Purpose {
  """
  \`SECURITY\` features provide metadata necessary to securely resolve fields.
  """
  SECURITY
  """
  \`EXECUTION\` features provide metadata necessary for operation execution.
  """
  EXECUTION
}

enum join__Graph {
  PRODUCTS @join__graph(name: "Products", url: "http://localhost:<OASService_port>")
  SUPPLIERS @join__graph(name: "Suppliers", url: "http://localhost:<OASService_port>")
}

directive @discriminator(subgraph: String, field: String, mapping: [[String]]) repeatable on INTERFACE | UNION

directive @connect(
  source: String
  http: ConnectHTTP
  selection: String!
  entity: Boolean
  errors: ConnectorErrors
  isSuccess: String
) repeatable on FIELD_DEFINITION | OBJECT

directive @extraSchemaDefinitionDirective(directives: _DirectiveExtensions) repeatable on OBJECT

directive @merge(
  subgraph: String
  argsExpr: String
  keyArg: String
  keyField: String
  key: [String!]
  additionalArgs: String
) repeatable on FIELD_DEFINITION

scalar _DirectiveExtensions @join__type(graph: PRODUCTS) @join__type(graph: SUPPLIERS)

type Electronics implements Product @join__type(graph: PRODUCTS) @join__implements(graph: PRODUCTS, interface: "Product") {
  warranty: String
  _links: ProductLinks
  _type: String
  id: Int
  name: String
  price: Float
  supplierId: Int
  """
  Get a product by ID
  """
  self: Product @connect(
    source: "Products"
    http: {GET: "/products/{root['id']}", headers: [{name: "accept", value: "application/json"}]}
    selection: "$"
  )
}

type ProductLinks @join__type(graph: PRODUCTS) {
  self: Link!
  supplier: Link!
}

type Link @join__type(graph: PRODUCTS) {
  href: String!
}

type Clothing implements Product @join__type(graph: PRODUCTS) @join__implements(graph: PRODUCTS, interface: "Product") {
  material: String
  _links: ProductLinks
  _type: String
  id: Int
  name: String
  price: Float
  supplierId: Int
  """
  Get a product by ID
  """
  self: Product @connect(
    source: "Products"
    http: {GET: "/products/{root['id']}", headers: [{name: "accept", value: "application/json"}]}
    selection: "$"
  )
}

type Query @extraSchemaDefinitionDirective(
  directives: {source: [{name: "Products", http: {baseURL: "http://localhost:<OASService_port>"}}], transport: [{subgraph: "Products", kind: "rest", location: "http://localhost:<OASService_port>"}]}
) @extraSchemaDefinitionDirective(
  directives: {source: [{name: "Suppliers", http: {baseURL: "http://localhost:<OASService_port>"}}], transport: [{subgraph: "Suppliers", kind: "rest", location: "http://localhost:<OASService_port>"}]}
) @join__type(graph: PRODUCTS) @join__type(graph: SUPPLIERS) {
  """
  Get all the products
  """
  getProducts: ProductList @connect(
    source: "Products"
    http: {GET: "/products/", headers: [{name: "accept", value: "application/json"}]}
    selection: "items"
  ) @join__field(graph: PRODUCTS)
  """
  Get a product by ID
  """
  getProductById("""
  The product ID
  """
  id: Int!): Product @connect(
    source: "Products"
    http: {GET: "/products/{$args.id}", headers: [{name: "accept", value: "application/json"}]}
    selection: "$"
  ) @join__field(graph: PRODUCTS)
  """
  Get a supplier by ID
  """
  getSupplierById("""
  The supplier ID
  """
  id: Int!): Supplier @connect(
    source: "Suppliers"
    http: {GET: "/suppliers/{$args.id}", headers: [{name: "accept", value: "application/json"}]}
    selection: "id\\nname\\naddress"
  ) @merge(subgraph: "Suppliers", keyField: "id", keyArg: "id") @join__field(graph: SUPPLIERS)
}

type ProductList @join__type(graph: PRODUCTS) {
  items: [Product]
}

type Supplier @join__type(graph: SUPPLIERS, key: "id") {
  id: Int
  name: String
  address: String
}

interface Product @discriminator(
  subgraph: "Products"
  field: "_type"
  mapping: [["ELECTRONICS", "Electronics"], ["CLOTHING", "Clothing"]]
) @join__type(graph: PRODUCTS) {
  _links: ProductLinks
  _type: String
  id: Int
  name: String
  price: Float
  supplierId: Int
  """
  Get a product by ID
  """
  self: Product @connect(
    source: "Products"
    http: {GET: "/products/{root['id']}", headers: [{name: "accept", value: "application/json"}]}
    selection: "$"
  )
}

input ConnectHTTP @join__type(graph: PRODUCTS) @join__type(graph: SUPPLIERS) {
  GET: String
  HEAD: String
  POST: String
  PUT: String
  PATCH: String
  DELETE: String
  headers: [HTTPHeaderMapping!]
  body: String
  queryParams: String
}

input HTTPHeaderMapping @join__type(graph: PRODUCTS) @join__type(graph: SUPPLIERS) {
  name: String!
  value: String
  from: String
}

input ConnectorErrors @join__type(graph: PRODUCTS) @join__type(graph: SUPPLIERS) {
  message: String
  extensions: String
}

input SourceHTTP @join__type(graph: PRODUCTS) @join__type(graph: SUPPLIERS) {
  baseURL: String!
  headers: [HTTPHeaderMapping!]
  queryParams: String
  errors: ConnectorErrors
  isSuccess: String
}"
`;
