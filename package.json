    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@babel/core": "7.29.7",
    "@graphql-mesh/utils": "workspace:*",
    "@grpc/grpc-js": "1.14.5",
    "@humanfs/node": "0.16.8",
    "@n1ru4l/in-memory-live-query-store": "0.11.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "@tootallnate/once": "3.0.1",
    "@whatwg-node/fetch": "0.10.13",
    "@whatwg-node/node-fetch": "0.8.5",
    "@whatwg-node/server": "0.11.0",
    "@xmldom/xmldom": "0.9.12",
    "axios": "1.18.1",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.8",
    "cookie": "1.1.1",
    "cross-fetch": "^4.0.0",
    "date-and-time": "^4.0.0",
    "es5-ext": "0.10.64",
    "esbuild": "^0.28.2",
    "eslint": "10.8.1",
    "estree-util-value-to-estree": "3.5.0",
