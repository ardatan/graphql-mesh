    "xml2js": "^0.6.0"
  },
  "lint-staged": {
    "packages/**/src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{ts,tsx,graphql,yml,json,md,js,mjs,cjs,mdx}": [
      "prettier --write"
    ]
  }
}
