type DepartmentPayload {
  department: Department
}

input CreateDepartmentInput {
  id: ID!
  deptName: String!
}

input UpdateDepartmentInput {
  deptName: String
}

type DeleteDepartmentPayload {
  ok: Boolean!
  affectedRows: Int!
}

type DeptEmpPayload {
  deptEmp: DeptEmp
}

input CreateDeptEmpInput {
  empNo: Int!
  deptNo: String!
  fromDate: Date!
  toDate: Date!
}

type DeptManagerPayload {
  deptManager: DeptManager
}

input CreateDeptManagerInput {
  empNo: Int!
  deptNo: String!
  fromDate: Date!
  toDate: Date!
}

type EmployeePayload {
  employee: Employee
}

input CreateEmployeeInput {
  id: ID!
  birthDate: Date!
  firstName: String!
  lastName: String!
  gender: String!
  hireDate: Date!
}

input UpdateEmployeeInput {
  birthDate: Date
  firstName: String
  lastName: String
  gender: String
  hireDate: Date
}

type DeleteEmployeePayload {
  ok: Boolean!
  affectedRows: Int!
}

type SalaryPayload {
  salary: Salary
}

input CreateSalaryInput {
  empNo: Int!
  salary: Int!
  fromDate: Date!
  toDate: Date!
}

type TitlePayload {
  title: Title
}

input CreateTitleInput {
  empNo: Int!
  title: String!
  fromDate: Date!
  toDate: Date
}

scalar TransportOptions

enum SqlKind {
  ROW
  ROWS
  CONNECTION
  COUNT
  INSERT
  UPDATE
  DELETE
}"
`;

