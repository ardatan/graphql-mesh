exports[`Batching Example should generate correct schema 1`] = `
"schema {
  query: Query
  mutation: Mutation
}

directive @connect(entity: Boolean, errors: ConnectorErrors, http: ConnectHTTP, isSuccess: String, selection: String!, source: String) repeatable on FIELD_DEFINITION | OBJECT

directive @link(import: [String], url: String!) repeatable on SCHEMA

directive @source(errors: ConnectorErrors, http: SourceHTTP!, isSuccess: String, name: String!) repeatable on SCHEMA

input ConnectHTTP {
  DELETE: String
  GET: String
  HEAD: String
  PATCH: String
  POST: String
  PUT: String
  body: String
  headers: [HTTPHeaderMapping!]
  queryParams: String
}

input ConnectorErrors {
  extensions: String
  message: String
}

input HTTPHeaderMapping {
  from: String
  name: String!
  value: String
}

type Mutation {
  usersByIds(input: UsersByIdRequest_Input): UsersByIdResponse @connect(source: "ExampleAPI", http: {POST: "/users_by_ids", headers: [{name: "Content-Type", value: "application/json"}, {name: "accept", value: "application/json"}], body: "$args.input"}, selection: "results {\\n  id\\n  name\\n}")
}

type Query {
  dummy: String
  user(id: Float!): User
}

input SourceHTTP {
  baseURL: String!
  errors: ConnectorErrors
  headers: [HTTPHeaderMapping!]
  isSuccess: String
  queryParams: String
}

type User {
  id: Float!
  name: String!
}

input UsersByIdRequest_Input {
  ids: [Float]!
}

type UsersByIdResponse {
  results: [User]!
}"
`;

