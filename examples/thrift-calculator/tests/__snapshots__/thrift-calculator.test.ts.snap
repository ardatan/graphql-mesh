"schema @transport(subgraph: "Calculator", kind: "thrift", location: "http://localhost:9876/thrift", headers: []) {
  query: Query
}

directive @thrift__rpc(subgraph: String, service: String, function: String!, args: String!, selection: String!, throws: String, messageType: ThriftMessageType = CALL, entity: Boolean) on FIELD_DEFINITION

enum ThriftMessageType {
  CALL
  ONEWAY
}

type CalcError {
  message: String
}

type Query {
  add(request: AddRequestInput): Int @thrift__rpc(subgraph: "Calculator", function: "add", args: "# Add left and right from the request struct.\\n1(struct): $args.request {\\n  1(i32): left\\n  2(i32): right\\n}", selection: "# Add left and right from the request struct.\\n$(i32)", messageType: CALL, service: "calculator-service")
  subtract(left: Int, right: Int): Int @thrift__rpc(subgraph: "Calculator", function: "subtract", args: "1(i32): $args.left\\n2(i32): $args.right", selection: "$(i32)", messageType: CALL, service: "calculator-service")
  divide(left: Int, right: Int): Int @thrift__rpc(subgraph: "Calculator", function: "divide", args: "# Divide left by right; throws when right is zero.\\n1(i32): $args.left\\n2(i32): $args.right", selection: "# Divide left by right; throws when right is zero.\\n$(i32)", messageType: CALL, service: "calculator-service")
  zip: Void @thrift__rpc(subgraph: "Calculator", function: "zip", args: "", selection: "$(void)", messageType: ONEWAY, service: "calculator-service")
}

input AddRequestInput {
  left: Int!
  right: Int!
}

"""Represents NULL values"""
scalar Void"
