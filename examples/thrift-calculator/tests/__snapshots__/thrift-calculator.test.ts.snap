directive @thrift__rpc(subgraph: String, service: String, function: String!, args: String!, selection: String!, messageType: ThriftMessageType = CALL, entity: Boolean) on FIELD_DEFINITION

enum ThriftMessageType {
  CALL
  ONEWAY
}

type Query {
  add(request: AddRequestInput): Int @thrift__rpc(subgraph: "Calculator", function: "add", args: "1(struct): $args.request {\\n  1(i32): left\\n  2(i32): right\\n}", selection: "$(i32)", messageType: CALL, service: "calculator-service")
  subtract(left: Int, right: Int): Int @thrift__rpc(subgraph: "Calculator", function: "subtract", args: "1(i32): $args.left\\n2(i32): $args.right", selection: "$(i32)", messageType: CALL, service: "calculator-service")
}

input AddRequestInput {
  left: Int!
  right: Int!
}"
`;

