}

input StringQueryOperators {
  eq: String
  exists: Boolean
  gt: String
  gte: String
  in: [String!]
  lt: String
  lte: String
  ne: String
  nin: [String!]
  regex: String
}

scalar TransportOptions

type User @key(fields: "id") @mongo__findOne(subgraph: "Mongoose", collection: "user_users", query: """

  _id: $this.id
""", selection: """
  id: _id
  name: name
  age: age
  languages: languages
  gender: gender
  address: address
  someMixed: someMixed
  salaryDecimal: salaryDecimal
  contacts: contacts
""") {
  address: UserAddress
  age: Float
  contacts: UserContacts
  gender: EnumUserGender
  id: ObjectID!
  languages: [UserLanguages]
  name: String
  salaryDecimal: Decimal128
  """Some dynamic data"""
  someMixed: JSON
}

type UserAddress {
  _id: ObjectID
  geo: [Float]
  street: String
}

input UserAddressFilterInput {
  _id: ObjectIDQueryOperators
  and: [UserAddressFilterInput!]
  geo: [Float]
  not: UserAddressFilterInput
  or: [UserAddressFilterInput!]
  street: StringQueryOperators
}

input UserAddressInput {
  _id: ObjectID
  geo: [Float]
  street: String
}

type UserConnection {
  edges: [UserEdge!]!
  nodes: [User!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type UserContacts {
  email: String
  phones: [String]
}

input UserContactsFilterInput {
  and: [UserContactsFilterInput!]
  email: StringQueryOperators
  not: UserContactsFilterInput
  or: [UserContactsFilterInput!]
  phones: [String]
}

input UserContactsInput {
  email: String
  phones: [String]
}

input UserDocumentInput {
  address: UserAddressInput
  age: Float
  contacts: UserContactsInput
  gender: EnumUserGender
  languages: [UserLanguagesInput]
  name: String
  salaryDecimal: Decimal128
  """Some dynamic data"""
  someMixed: JSON
}

type UserEdge {
  cursor: String!
  node: User!
}

input UserFilterInput {
  address: UserAddressFilterInput
  age: FloatQueryOperators
  and: [UserFilterInput!]
  contacts: UserContactsFilterInput
  gender: StringQueryOperators
  id: ObjectIDQueryOperators
  languages: [UserLanguagesFilterInput]
  name: StringQueryOperators
  not: UserFilterInput
  or: [UserFilterInput!]
  salaryDecimal: Decimal128QueryOperators
  """Some dynamic data"""
  someMixed: JSON
}

type UserLanguages {
  language: String
  skill: EnumUserLanguagesSkill
}

input UserLanguagesFilterInput {
  and: [UserLanguagesFilterInput!]
  language: StringQueryOperators
  not: UserLanguagesFilterInput
  or: [UserLanguagesFilterInput!]
  skill: StringQueryOperators
}

input UserLanguagesInput {
  language: String
  skill: EnumUserLanguagesSkill
}

input UserNumericUpdateInput {
  age: Float
  salaryDecimal: Decimal128
}

type UserPagination {
  count: Int
  items: [User]
  pageInfo: PaginationInfo
}

type UserPayload {
  createdCount: Int
  deletedCount: Int
  error: MongoError
  matchedCount: Int
  modifiedCount: Int
  record: User
  recordId: ObjectID
  recordIds: [ObjectID!]
  records: [User!]
}

input UserSetInput {
  address: UserAddressInput
  age: Float
  contacts: UserContactsInput
  gender: EnumUserGender
  languages: [UserLanguagesInput]
  name: String
  salaryDecimal: Decimal128
  """Some dynamic data"""
  someMixed: JSON
}

enum UserSort {
  age_asc
  age_desc
  gender_asc
  gender_desc
  id_asc
  id_desc
  name_asc
  name_desc
  salaryDecimal_asc
  salaryDecimal_desc
}

input UserUnsetInput {
  address: Boolean
  age: Boolean
  contacts: Boolean
  gender: Boolean
  languages: Boolean
  name: Boolean
  salaryDecimal: Boolean
  """Some dynamic data"""
  someMixed: Boolean
}

input UserUpdateInput {
  addToSet: JSON
  bit: JSON
  currentDate: JSON
  inc: UserNumericUpdateInput
  max: UserNumericUpdateInput
  min: UserNumericUpdateInput
  mul: UserNumericUpdateInput
  pop: JSON
  pull: JSON
  pullAll: JSON
  push: JSON
  rename: JSON
  set: UserSetInput
  unset: UserUnsetInput
}"
`;
