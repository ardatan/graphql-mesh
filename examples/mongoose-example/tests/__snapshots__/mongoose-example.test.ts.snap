  endCursor: String
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
}

type PaginationInfo {
  currentPage: Int!
  hasNextPage: Boolean
  hasPreviousPage: Boolean
  itemCount: Int
  pageCount: Int
  perPage: Int!
}

