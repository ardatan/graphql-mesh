// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Mongoose should generate correct schema 1`] = `
"directive @mongo__aggregate(collection: String!, pipeline: String, query: String, selection: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__connection(after: String, collection: String!, first: String, query: String, selection: String, sort: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__count(collection: String!, query: String, selection: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__deleteMany(collection: String!, query: String, selection: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__deleteOne(collection: String!, query: String, selection: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__find(collection: String!, limit: String, query: String, selection: String, skip: String, sort: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__findOne(collection: String!, query: String, selection: String, skip: String, sort: String, subgraph: String) on FIELD_DEFINITION | OBJECT

directive @mongo__insertMany(collection: String!, selection: String, set: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__insertOne(collection: String!, selection: String, set: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__pagination(collection: String!, page: String, perPage: String, query: String, selection: String, sort: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__updateMany(collection: String!, query: String, selection: String, set: String, subgraph: String) on FIELD_DEFINITION

directive @mongo__updateOne(collection: String!, query: String, selection: String, set: String, subgraph: String) on FIELD_DEFINITION

directive @transport(headers: [[String]], kind: String!, location: String, options: TransportOptions, subgraph: String!) repeatable on SCHEMA

"""
BSON Decimal128 (Mongoose-compatible cast). Serialized as a decimal string; accepts string, number, or \`{ "$numberDecimal": "…" }\`.
"""
scalar Decimal128

input Decimal128QueryOperators {
  eq: Decimal128
  exists: Boolean
  gt: Decimal128
  gte: Decimal128
  in: [Decimal128!]
  lt: Decimal128
  lte: Decimal128
  ne: Decimal128
  nin: [Decimal128!]
}

enum EnumUserGender {
  female
  male
  not_specified
}

enum EnumUserLanguagesSkill {
  basic
  fluent
  native
}

interface ErrorInterface {
  message: String
}

input FloatQueryOperators {
  eq: Float
  exists: Boolean
  gt: Float
  gte: Float
  in: [Float!]
  lt: Float
  lte: Float
  ne: Float
  nin: [Float!]
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

type MongoError implements ErrorInterface {
  code: String
  message: String
}

type Mutation {
  deleteManyUsers(query: UserQueryInput!): UserPayload
  deleteOneUser(query: UserQueryInput!): UserPayload
  deleteUserById(id: ObjectID!): UserPayload
  insertManyUsers(documents: [UserDocumentInput!]!): UserPayload
  insertOneUser(document: UserDocumentInput!): UserPayload
  updateManyUsers(query: UserQueryInput!, update: JSON!): UserPayload
  updateOneUser(query: UserQueryInput!, update: JSON!): UserPayload
  updateUserById(id: ObjectID!, update: JSON!): UserPayload
}

"""
A field whose value conforms with the standard mongodb object ID as described here: https://docs.mongodb.com/manual/reference/method/ObjectId/#ObjectId. Example: 5e5677d71bdc2ae76344968c
"""
scalar ObjectID

input ObjectIDQueryOperators {
  eq: ObjectID
  exists: Boolean
  gt: ObjectID
  gte: ObjectID
  in: [ObjectID!]
  lt: ObjectID
  lte: ObjectID
  ne: ObjectID
  nin: [ObjectID!]
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
}

type PaginationInfo {
  currentPage: Int!
  hasNextPage: Boolean
  hasPreviousPage: Boolean
  itemCount: Int
  pageCount: Int
  perPage: Int!
}

type Query {
  aggregateUsers(pipeline: JSON, query: UserQueryInput): [JSON!]!
  countDocumentsUsers(query: UserQueryInput): Int!
  findOneUser(query: UserQueryInput, skip: Int, sort: [UserSort!]): User
  findUserById(id: ObjectID!): User
  findUsers(limit: Int = 100, query: UserQueryInput, skip: Int, sort: [UserSort!]): [User!]!
  findUsersByIds(ids: [ObjectID!]!, limit: Int = 100, sort: [UserSort!]): [User!]!
  findUsersConnection(after: String, first: Int, query: UserQueryInput, sort: [UserSort!]): UserConnection
  findUsersPagination(page: Int, perPage: Int = 20, query: UserQueryInput, sort: [UserSort!]): UserPagination
}

input StringQueryOperators {
  eq: String
  exists: Boolean
  gt: String
  gte: String
  in: [String!]
  lt: String
  lte: String
  ne: String
  nin: [String!]
  regex: String
}

scalar TransportOptions

type User {
  address: UserAddress
  age: Float
  contacts: UserContacts
  gender: EnumUserGender
  id: ObjectID!
  languages: [UserLanguages]
  name: String
  salaryDecimal: Decimal128

  """Some dynamic data"""
  someMixed: JSON
}

type UserAddress {
  _id: ObjectID
  geo: [Float]
  street: String
}

input UserAddressInput {
  _id: ObjectID
  geo: [Float]
  street: String
}

input UserAddressQueryInput {
  _id: ObjectIDQueryOperators
  and: [UserAddressQueryInput!]
  geo: [Float]
  not: UserAddressQueryInput
  or: [UserAddressQueryInput!]
  street: StringQueryOperators
}

type UserConnection {
  edges: [UserEdge!]!
  nodes: [User!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type UserContacts {
  email: String
  phones: [String]
}

input UserContactsInput {
  email: String
  phones: [String]
}

input UserContactsQueryInput {
  and: [UserContactsQueryInput!]
  email: StringQueryOperators
  not: UserContactsQueryInput
  or: [UserContactsQueryInput!]
  phones: [String]
}

input UserDocumentInput {
  address: UserAddressInput
  age: Float
  contacts: UserContactsInput
  gender: EnumUserGender
  languages: [UserLanguagesInput]
  name: String
  salaryDecimal: Decimal128

  """Some dynamic data"""
  someMixed: JSON
}

type UserEdge {
  cursor: String!
  node: User!
}

type UserLanguages {
  language: String
  skill: EnumUserLanguagesSkill
}

input UserLanguagesInput {
  language: String
  skill: EnumUserLanguagesSkill
}

input UserLanguagesQueryInput {
  and: [UserLanguagesQueryInput!]
  language: StringQueryOperators
  not: UserLanguagesQueryInput
  or: [UserLanguagesQueryInput!]
  skill: StringQueryOperators
}

type UserPagination {
  count: Int
  items: [User]
  pageInfo: PaginationInfo
}

type UserPayload {
  createdCount: Int
  deletedCount: Int
  error: MongoError
  matchedCount: Int
  modifiedCount: Int
  record: User
  recordId: ObjectID
  recordIds: [ObjectID!]
  records: [User!]
}

input UserQueryInput {
  address: UserAddressQueryInput
  age: FloatQueryOperators
  and: [UserQueryInput!]
  contacts: UserContactsQueryInput
  gender: StringQueryOperators
  id: ObjectIDQueryOperators
  languages: [UserLanguagesQueryInput]
  name: StringQueryOperators
  not: UserQueryInput
  or: [UserQueryInput!]
  salaryDecimal: Decimal128QueryOperators

  """Some dynamic data"""
  someMixed: JSON
}

enum UserSort {
  age_asc
  age_desc
  gender_asc
  gender_desc
  id_asc
  id_desc
  name_asc
  name_desc
  salaryDecimal_asc
  salaryDecimal_desc
}"
`;
