// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Mongoose should generate correct schema 1`] = `
"directive @mongo(after: String, collection: String!, first: String, kind: MongoKind!, limit: String, orderBy: String, page: String, perPage: String, pipeline: String, selection: String, set: String, skip: String, subgraph: String, where: String) on FIELD_DEFINITION | OBJECT

directive @transport(headers: [[String]], kind: String!, location: String, options: TransportOptions, subgraph: String!) repeatable on SCHEMA

input CreateUserInput {
  address: JSON
  age: Float
  gender: String
  languages: JSON
  name: String
  salaryDecimal: Decimal128
  someMixed: JSON
}

"""
BSON Decimal128 value. Serialized and parsed as a decimal string (e.g. \`"12.50"\`).
"""
scalar Decimal128

input Decimal128Filter {
  eq: Decimal128
  exists: Boolean
  gt: Decimal128
  gte: Decimal128
  in: [Decimal128!]
  lt: Decimal128
  lte: Decimal128
  ne: Decimal128
  nin: [Decimal128!]
}

interface ErrorInterface {
  message: String
}

input FloatFilter {
  eq: Float
  exists: Boolean
  gt: Float
  gte: Float
  in: [Float!]
  lt: Float
  lte: Float
  ne: Float
  nin: [Float!]
}

input IDFilter {
  eq: ID
  exists: Boolean
  in: [ID!]
  ne: ID
  nin: [ID!]
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

type MongoError implements ErrorInterface {
  code: String
  message: String
}

enum MongoKind {
  AGGREGATE
  CONNECTION
  COUNT
  DELETE_MANY
  DELETE_ONE
  FIND_MANY
  FIND_ONE
  INSERT_MANY
  INSERT_ONE
  PAGINATION
  UPDATE_MANY
  UPDATE_ONE
}

type Mutation {
  createUser(input: CreateUserInput!): UserPayload
  createUsers(inputs: [CreateUserInput!]!): UserPayload
  deleteUser(id: ID!): UserPayload
  deleteUserWhere(where: UserWhereInput): UserPayload
  deleteUsers(where: UserWhereInput!): UserPayload
  updateUser(id: ID!, input: UpdateUserInput!): UserPayload
  updateUserWhere(input: UpdateUserInput!, where: UserWhereInput): UserPayload
  updateUsers(input: UpdateUserInput!, where: UserWhereInput): UserPayload
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
}

type PaginationInfo {
  currentPage: Int!
  hasNextPage: Boolean
  hasPreviousPage: Boolean
  itemCount: Int
  pageCount: Int
  perPage: Int!
}

type Query {
  aggregateUsers(pipeline: JSON, where: UserWhereInput): [JSON!]!
  allUsers(after: String, first: Int, orderBy: UserOrderByInput, where: UserWhereInput): UserConnection
  findUser(orderBy: UserOrderByInput, skip: Int, where: UserWhereInput): User
  user(id: ID!): User
  users(limit: Int = 100, orderBy: UserOrderByInput, skip: Int, where: UserWhereInput): [User!]!
  usersByIds(ids: [ID!]!, limit: Int = 100, orderBy: UserOrderByInput): [User!]!
  usersCount(where: UserWhereInput): Int!
  usersPagination(orderBy: UserOrderByInput, page: Int, perPage: Int = 20, where: UserWhereInput): UserPagination
}

enum SortDirection {
  ASC
  DESC
}

input StringFilter {
  eq: String
  exists: Boolean
  in: [String!]
  ne: String
  nin: [String!]
  regex: String
}

scalar TransportOptions

input UpdateUserInput {
  address: JSON
  age: Float
  gender: String
  languages: JSON
  name: String
  salaryDecimal: Decimal128
  someMixed: JSON
}

type User {
  address: JSON
  age: Float
  gender: String
  id: ID!
  languages: JSON
  name: String
  salaryDecimal: Decimal128
  someMixed: JSON
}

type UserConnection {
  edges: [UserEdge!]!
  nodes: [User!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type UserEdge {
  cursor: String!
  node: User!
}

input UserOrderByInput {
  address: SortDirection
  age: SortDirection
  gender: SortDirection
  id: SortDirection
  languages: SortDirection
  name: SortDirection
  salaryDecimal: SortDirection
  someMixed: SortDirection
}

type UserPagination {
  count: Int
  items: [User]
  pageInfo: PaginationInfo
}

type UserPayload {
  createdCount: Int
  deletedCount: Int
  error: MongoError
  matchedCount: Int
  modifiedCount: Int
  record: User
  recordId: ID
  recordIds: [ID!]
  records: [User!]
}

input UserWhereInput {
  AND: [UserWhereInput!]
  NOT: UserWhereInput
  OR: [UserWhereInput!]
  address: StringFilter
  age: FloatFilter
  gender: StringFilter
  id: IDFilter
  languages: StringFilter
  name: StringFilter
  salaryDecimal: Decimal128Filter
  someMixed: StringFilter
}"
`;
