// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Mongoose should generate correct schema 1`] = `
"directive @mongo(after: String, collection: String!, filter: String, first: String, kind: MongoKind!, limit: String, page: String, perPage: String, pipeline: String, selection: String, set: String, skip: String, sort: String, subgraph: String) on FIELD_DEFINITION | OBJECT

directive @transport(headers: [[String]], kind: String!, location: String, options: TransportOptions, subgraph: String!) repeatable on SCHEMA

"""
BSON Decimal128 (Mongoose-compatible cast). Serialized as a decimal string; accepts string, number, or \`{ "$numberDecimal": "…" }\`.
"""
scalar Decimal128

enum EnumUserGender {
  female
  male
  not_specified
}

enum EnumUserLanguagesSkill {
  basic
  fluent
  native
}

interface ErrorInterface {
  message: String
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

type MongoError implements ErrorInterface {
  code: String
  message: String
}

enum MongoKind {
  AGGREGATE
  CONNECTION
  COUNT
  DELETE_MANY
  DELETE_ONE
  FIND_MANY
  FIND_ONE
  INSERT_MANY
  INSERT_ONE
  PAGINATION
  UPDATE_MANY
  UPDATE_ONE
}

type Mutation {
  deleteManyUsers(filter: JSON!): UserPayload
  deleteOneUser(filter: JSON!): UserPayload
  deleteUserById(id: ID!): UserPayload
  insertManyUsers(documents: [UserDocumentInput!]!): UserPayload
  insertOneUser(document: UserDocumentInput!): UserPayload
  updateManyUsers(filter: JSON!, update: JSON!): UserPayload
  updateOneUser(filter: JSON!, update: JSON!): UserPayload
  updateUserById(id: ID!, update: JSON!): UserPayload
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
}

type PaginationInfo {
  currentPage: Int!
  hasNextPage: Boolean
  hasPreviousPage: Boolean
  itemCount: Int
  pageCount: Int
  perPage: Int!
}

type Query {
  aggregateUsers(filter: JSON, pipeline: JSON): [JSON!]!
  countDocumentsUsers(filter: JSON): Int!
  findOneUser(filter: JSON, skip: Int, sort: JSON): User
  findUserById(id: ID!): User
  findUsers(filter: JSON, limit: Int = 100, skip: Int, sort: JSON): [User!]!
  findUsersByIds(ids: [ID!]!, limit: Int = 100, sort: JSON): [User!]!
  findUsersConnection(after: String, filter: JSON, first: Int, sort: JSON): UserConnection
  findUsersPagination(filter: JSON, page: Int, perPage: Int = 20, sort: JSON): UserPagination
}

scalar TransportOptions

type User {
  address: UserAddress
  age: Float
  contacts: UserContacts
  gender: EnumUserGender
  id: ID!
  languages: [UserLanguages]
  name: String
  salaryDecimal: Decimal128

  """Some dynamic data"""
  someMixed: JSON
}

type UserAddress {
  _id: ID
  geo: [Float]
  street: String
}

input UserAddressInput {
  _id: ID
  geo: [Float]
  street: String
}

type UserConnection {
  edges: [UserEdge!]!
  nodes: [User!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type UserContacts {
  email: String
  phones: [String]
}

input UserContactsInput {
  email: String
  phones: [String]
}

input UserDocumentInput {
  address: UserAddressInput
  age: Float
  contacts: UserContactsInput
  gender: EnumUserGender
  languages: [UserLanguagesInput]
  name: String
  salaryDecimal: Decimal128

  """Some dynamic data"""
  someMixed: JSON
}

type UserEdge {
  cursor: String!
  node: User!
}

type UserLanguages {
  language: String
  skill: EnumUserLanguagesSkill
}

input UserLanguagesInput {
  language: String
  skill: EnumUserLanguagesSkill
}

type UserPagination {
  count: Int
  items: [User]
  pageInfo: PaginationInfo
}

type UserPayload {
  createdCount: Int
  deletedCount: Int
  error: MongoError
  matchedCount: Int
  modifiedCount: Int
  record: User
  recordId: ID
  recordIds: [ID!]
  records: [User!]
}"
`;
