"schema @source(name: "FHIR", http: { baseURL: "{$env.FHIR_BASE}" }) @link(url: "https://specs.apollo.dev/connect/v0.4", import: ["@connect", "@source"]) {
  query: Query
}

directive @regexp(subgraph: String, pattern: String) repeatable on SCALAR

directive @typescript(subgraph: String, type: String) repeatable on SCALAR | ENUM

directive @connect(source: String, http: ConnectHTTP, selection: JSONSelection!, entity: Boolean, errors: ConnectorErrors, isSuccess: JSONSelection) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHTTP!, errors: ConnectorErrors, isSuccess: JSONSelection) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

directive @resolveTo(requiredSelectionSet: String, sourceName: String, sourceTypeName: String, sourceFieldName: String, sourceSelectionSet: String, sourceArgs: ResolveToSourceArgs, keyField: String, keysArg: String, valueKeyField: String, pubsubTopic: String, filterBy: String, additionalArgs: ResolveToSourceArgs, result: String, resultType: String) on FIELD_DEFINITION

type Query {
  resourceById(resourceType: String, id: String): ResourceList @connect(source: "FHIR", http: { GET: "/{$args.resourceType}/{$args.id}?_format=application/json" }, selection: "$")
  resourceByName(resourceType: String, name: String): Bundle @connect(source: "FHIR", http: { GET: "/{$args.resourceType}/?name={$args.name}?_format=application/json" }, selection: """
  resourceType
  id
  meta {
    id
    versionId
    lastUpdated
    source
    profile
  }
  implicitRules
  _implicitRules {
    id
  }
  language
  _language {
    id
  }
  identifier {
    id
    use
    system
    value
  }
  type: type->match(["transaction-response", "transaction_response"], ["batch-response", "batch_response"], [@, type])
  _type {
    id
  }
  timestamp
  _timestamp {
    id
  }
  total
  _total {
    id
  }
  link {
    id
    relation
    url
  }
  entry {
    id
    fullUrl
  }
  signature {
    id
    when
    targetFormat
    sigFormat
    data
  }
  """)
  resourceByOtherResourceId(resourceType: String, otherResourceType: String, otherResourceId: String): Bundle @connect(source: "FHIR", http: {
    GET: "/{$args.resourceType}?subject={$args.otherResourceType}/{$args.otherResourceId}"
  }, selection: """
  resourceType
  id
  meta {
    id
    versionId
    lastUpdated
    source
    profile
  }
  implicitRules
  _implicitRules {
    id
  }
  language
  _language {
    id
  }
  identifier {
    id
    use
    system
    value
  }
  type: type->match(["transaction-response", "transaction_response"], ["batch-response", "batch_response"], [@, type])
  _type {
    id
  }
  timestamp
  _timestamp {
    id
  }
  total
  _total {
    id
  }
  link {
    id
    relation
    url
  }
  entry {
    id
    fullUrl
  }
  signature {
    id
    when
    targetFormat
    sigFormat
    data
  }
  """)
}

