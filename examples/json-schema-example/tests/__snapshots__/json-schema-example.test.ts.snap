// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`JSON Schema Example should generate correct schema 1`] = `
"schema {
  query: Query
  mutation: Mutation
}

directive @enum(subgraph: String, value: String) on ENUM_VALUE

directive @example(subgraph: String, value: ObjMap) repeatable on FIELD_DEFINITION | OBJECT | INPUT_OBJECT | ENUM | SCALAR

directive @connect(source: String, http: ConnectHttp, selection: String!, entity: Boolean, errors: ConnectorErrors, isSuccess: String) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHttp!, errors: ConnectorErrors, isSuccess: String) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

type Query {
  me: User @connect(source: "FakeAPI", http: {GET: "/me"}, selection: "firstName lastName jobTitle companyId birthDate foos { id }")
  company(id: String!): Company @connect(source: "FakeAPI", http: {GET: "/company/{$args.id}"}, selection: "name type")
}

"""Fake User Object"""
type User {
  firstName: String
  lastName: String
  jobTitle: String
  companyId: String
  birthDate: Date
  foos: [Foo]
  company: Company
}

"""Represents date values"""
scalar Date

type Foo {
  id: String
}

"""Fake Company"""
type Company {
  name: String
  type: CompanyType
  employers: [User]
}

enum CompanyType {
  Public_Limited @enum(subgraph: "FakeAPI", value: "\\"Public Limited\\"")
  Private_Limited @enum(subgraph: "FakeAPI", value: "\\"Private Limited\\"")
  One_Person @enum(subgraph: "FakeAPI", value: "\\"One Person\\"")
}

type Mutation {
  createUser(input: CreateUpdateUserInput): User @connect(source: "FakeAPI", http: {PUT: "/user", body: "$args.input"}, selection: "firstName lastName jobTitle companyId birthDate foos { id }")
  updateUser(id: String!, input: CreateUpdateUserInput): User @connect(source: "FakeAPI", http: {POST: "/user/{$args.id}", body: "$args.input"}, selection: "firstName lastName jobTitle companyId birthDate foos { id }")
  deleteUser(id: String!): JSON @connect(source: "FakeAPI", http: {DELETE: "/user/{$args.id}"}, selection: "$")
}

input CreateUpdateUserInput @example(subgraph: "FakeAPI", value: "{\\"firstName\\":\\"John\\",\\"lastName\\":\\"Doe\\",\\"jobTitle\\":\\"Software Developer\\"}") {
  firstName: String
  lastName: String
  jobTitle: String
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

scalar ObjMap

input ConnectHttp {
  get: String
  head: String
  post: String
  put: String
  patch: String
  delete: String
  headers: [HttpHeaderMapping!]
  body: String
  queryParams: String
}

input HttpHeaderMapping {
  name: String!
  value: String
  from: String
}

input ConnectorErrors {
  message: String
  extensions: String
}

input SourceHttp {
  baseUrl: String!
  headers: [HttpHeaderMapping!]
  queryParams: String
  errors: ConnectorErrors
  isSuccess: String
}"
