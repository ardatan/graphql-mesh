// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`JSON Schema Example should generate correct schema 1`] = `
"schema {
  query: Query
  mutation: Mutation
}

directive @example(subgraph: String, value: ObjMap) repeatable on FIELD_DEFINITION | OBJECT | INPUT_OBJECT | ENUM | SCALAR

directive @connect(source: String, http: ConnectHttp, selection: JsonSelection!, entity: Boolean, errors: ConnectorErrors, isSuccess: JsonSelection) repeatable on FIELD_DEFINITION | OBJECT

directive @source(name: String!, http: SourceHttp!, errors: ConnectorErrors, isSuccess: JsonSelection) repeatable on SCHEMA

directive @link(url: String!, import: [String]) repeatable on SCHEMA

type Query {
  me: User @connect(source: "FakeAPI", http: {}, selection: "firstName lastName jobTitle companyId birthDate foos { id }")
  company(id: String!): Company @connect(source: "FakeAPI", http: {}, selection: "name type: type->match([\\"Public Limited\\", \\"Public_Limited\\"], [\\"Private Limited\\", \\"Private_Limited\\"], [\\"One Person\\", \\"One_Person\\"], [@, type])")
}

"""Fake User Object"""
type User {
  firstName: String
  lastName: String
  jobTitle: String
  companyId: String
  birthDate: Date
  foos: [Foo]
  company: Company
}

"""Represents date values"""
scalar Date

type Foo {
  id: String
}

"""Fake Company"""
type Company {
  name: String
  type: CompanyType
  employers: [User]
}

enum CompanyType {
  Public_Limited
  Private_Limited
  One_Person
}

type Mutation {
  createUser(input: CreateUpdateUserInput): User @connect(source: "FakeAPI", http: {body: "$args.input"}, selection: "firstName lastName jobTitle companyId birthDate foos { id }")
  updateUser(id: String!, input: CreateUpdateUserInput): User @connect(source: "FakeAPI", http: {body: "$args.input"}, selection: "firstName lastName jobTitle companyId birthDate foos { id }")
  deleteUser(id: String!): JSON @connect(source: "FakeAPI", http: {}, selection: "$")
}

input CreateUpdateUserInput @example(subgraph: "FakeAPI", value: "{\\"firstName\\":\\"John\\",\\"lastName\\":\\"Doe\\",\\"jobTitle\\":\\"Software Developer\\"}") {
  firstName: String
  lastName: String
  jobTitle: String
}

"""
The \`JSON\` scalar type represents JSON values as specified by [ECMA-404](http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf).
"""
scalar JSON @specifiedBy(url: "http://www.ecma-international.org/publications/files/ECMA-ST/ECMA-404.pdf")

scalar ObjMap

input ConnectHttp {
  get: UrlPathTemplate
  head: UrlPathTemplate
  post: UrlPathTemplate
  put: UrlPathTemplate
  patch: UrlPathTemplate
  delete: UrlPathTemplate
  headers: [HttpHeaderMapping!]
  body: JsonSelection
  queryParams: JsonSelection
}

"""
A URL path with optional parameters, mapping to GraphQL fields or arguments
"""
scalar UrlPathTemplate

input HttpHeaderMapping {
  name: String!
  value: String
  from: String
}

"""A custom syntax for mapping JSON data to GraphQL schema"""
scalar JsonSelection

input ConnectorErrors {
  message: JsonSelection
  extensions: JsonSelection
}

input SourceHttp {
  baseUrl: String!
  headers: [HttpHeaderMapping!]
  queryParams: JsonSelection
}"
`;
